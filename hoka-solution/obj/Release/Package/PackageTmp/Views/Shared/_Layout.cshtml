</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Recarga de pagina -->
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__shake" src="~/Content/img/logo/LOGOBLANCO.png" alt="LogoHOKA" height="100" width="200">
        </div>


        @*AQUI IBA LA BARRA SIDEBAR*@

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a id="textotitulo" class="brand-link">
                <img src="~/Content/img/logo/SOLOBLANCO.png" alt="LogoHOKA" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="text-light font-weight-bold">HOKA</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user panel (optional) -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="~/Content/img/users/IconoUser.jpg" class="img-circle elevation-2" alt="User Image">
                    </div>

                    @{
                        // Obtener el correo electrónico de la sesión
                        string NombreU = Session["NombreU"] as string;
                    }

                    @if (NombreU != null)
                    {
                        <div class="info">
                            <a id="textotitulo" class="text-light font-weight-bold">Hola, @NombreU!</a>
                        </div>
                    }
                </div>

                <!-- SidebarSearch Form -->
                <div class="form-inline">
                    <div class="input-group" data-widget="sidebar-search">
                        <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search">
                        <div class="input-group-append">
                            <button class="btn btn-sidebar">
                                <i class="fas fa-search fa-fw"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">


                        @*<li class="nav-item">
            <a href="@Url.Action("Inicio","Home")" class="nav-link">
                <i class="nav-icon fas fa-file"></i>
                <p>Pagina Principal</p>
            </a>
        </li>*@
                        <li class="nav-header">CONFIGURACIÓN</li>

                        <li class="nav-item">
                            <a href="@Url.Action("ValidarAcceso", "Acceso")" id="accesoRe" class="nav-link">
                                <i class="fas fa-user-plus"></i>
                                <p>Crear Usuario</p>
                            </a>

                        </li>
                        <li class="nav-header">GRAFICAS GENERALES</li>

                        <li class="nav-item">
                            <a href="@Url.Action("Graficas", "Home")" class="nav-link">
                                <i class="fas fa-chart-pie"></i>
                                <p>Grafica de Productos</p>
                            </a>
                        </li>
                        <li class="nav-header">LISTA</li>

                        <li class="nav-item">
                            <a href="@Url.Action("InicioAlmacen", "Almacen")" class="nav-link">
                                <i class="fas fa-store"></i>
                                <p>Lista de Almacen</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("InicioRemisiod", "RemisioD")" class="nav-link">
                                <i class="fas fa-box-open"></i>
                                <p>Lista de Productos</p>
                            </a>
                        </li>

                        @{
                            var usuarioSesion = Session["usuario"] as UsuarioModel;

                        }

                        <!--BOTON DESPLEGABLE PARA VENTAS-->
                        @if (usuarioSesion != null && usuarioSesion.Id_Rol == 1 && (usuarioSesion.Permisos.Contains(1) || usuarioSesion.Permisos.Contains(2) || usuarioSesion.Permisos.Contains(3)))
                        {
                            <li class="nav-item">
                                <a href="#" class="nav-link toggle-menu">
                                    <i class="fas fa-file"></i>
                                    <p>
                                        REPORTES DE VENTA
                                        <i class="fas fa-angle-left right"></i>
                                    </p>
                                </a>
                                <ul class="nav nav-treeview1">
                                    @if (usuarioSesion.Permisos.Contains(1))
                                    {
                                        <li class="nav-item @(ViewBag.ActivePage == "VProductosAdmin" ? "active" : "")">
                                            <a href="@Url.Action("VProductosAdmin", "AdminPages")" class="nav-link">
                                                <i class="fas fa-file-alt"></i>
                                                <p>Reporte venta por producto</p>
                                            </a>
                                        </li>
                                    }

                                    @if (usuarioSesion.Permisos.Contains(2))
                                    {
                                        <li class="nav-item @(ViewBag.ActivePage == "VAlmacenAdmin" ? "active" : "")">
                                            <a href="@Url.Action("VAlmacenAdmin", "AdminPages")" class="nav-link">
                                                <i class="fas fa-file-alt"></i>
                                                <p>Reporte venta por departamento</p>
                                            </a>
                                        </li>
                                    }

                                    @if (usuarioSesion.Permisos.Contains(3))
                                    {
                                        <li class="nav-item @(ViewBag.ActivePage == "VVendedorAdmin" ? "active" : "")">
                                            <a href="@Url.Action("VVendedorAdmin", "AdminPages")" class="nav-link">
                                                <i class="fas fa-file-alt"></i>
                                                <p>Reporte de venta y comision por vendedor</p>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }


                    </ul>
                </nav>
                <!-- Sidebar user panel (optional) -->
                <nav class="navlay">
                    <hr class="line">
                    <!-- Sidebar user panel (optional) -->
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex brand-link">
                        <nav class="mt-2">
                            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                                <li class="nav-item">
                                    <a href="@Url.Action("CerrarSesion","Home")" class="nav-link">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <p>Cerrar Sesión</p>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        <!-- Content Wrapper. Contains page content -->

        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <!-- Main content -->
            @RenderBody()

        </div>
        <!-- /.content-wrapper -->

        <footer class="main-header">
            <p>&copy; @DateTime.Now.Year - SOFTRITON</p>
        </footer>

    </div>
    <!-- ./wrapper -->
    <!-- jQuery -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

