    <!-- Jquery Scripts para la DATATABLE -->
    @*<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/v/bs5/dt-1.11.3/datatables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/searchpanes/2.1.2/js/dataTables.searchPanes.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/select/1.6.2/js/dataTables.select.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://code.highcharts.com/highcharts.js"></script>*@

    <!-- Lenguaje en español para el DATATABLE -->
@*    <script src="https://cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"></script>*@

    <!-- Para hacer la suma -->
@*    <script src="https://cdn.datatables.net/plug-ins/1.10.20/api/sum().js"></script>

    <script src="https://cdn.datatables.net/fixedheader/3.3.1/js/dataTables.fixedHeader.min.js"></script>*@

    <!-- Botones para imprimir -->
@*    <script src="https://cdn.datatables.net/buttons/2.3.4/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
