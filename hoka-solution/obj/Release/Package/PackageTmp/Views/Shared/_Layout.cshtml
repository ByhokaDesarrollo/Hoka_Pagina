    <script src="https://cdn.datatables.net/buttons/2.3.4/js/buttons.print.min.js"></script>*@


    @RenderSection("scripts", required: false)

    <!-- AdminLTE App -->
    <script src="~/Content/dist/js/adminlte.js"></script>
</body>
</html>

