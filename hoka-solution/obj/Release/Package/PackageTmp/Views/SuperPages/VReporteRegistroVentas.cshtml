
@{
    ViewBag.Title = "REPORTE";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioUser", "UserPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion", "Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>REPORTE REGISTRO DE VENTAS</h1>
                        </div>
                    </div>
                </div>
                <hr />
                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        
                        <div class="row">
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                <label for="fecha">Fecha </label>
                                <input type="text" id="fecha" name="fecha" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                <label for="almacen">Almacén</label>
                                <select class="form-control select2 almacen-select" style="width: 100%" id="idAlmacen" name="idAlmacen">
                                    <option selected="selected">Seleccionar</option>
                                    @foreach (var almacen in ViewBag.Almacenes)
                                    {
                                        <option value="@almacen.Item1">@($"{almacen.Item1} - {almacen.Item2}")</option>
                                    }
                                </select>
                            </div>

                            <div class="col-lg-2 col-md-4 col-sm-6 col-12 mt-2 mt-lg-0">
                                <label for="btn-filter">Filtrar</label>
                                <div>
                                    <button type="submit" id="btn-filter" class="btn btn-info">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="card-body">
                            <div class="table table-responsive">
                                <table class="table table-striped" id="tableContainer">
                                    <thead>
                                        <tr>
                                            <th>Categoria</th>
                                            <th>Venta</th>
                                            <th>Comisiones Clave</th>
                                            <th>Neto Venta</th>
                                            <th>Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                         
                                    </tbody>
                                    <thead>
                                        <th></th>
                                        <th id="totalVenta"></th>
                                        <th id="totalComisiones"></th>
                                        <th id="totalNetoVenta"></th>
                                        <th></th>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>


</body>
</html>

@section scripts {

    <script>

    $(document).ready(function () {

        $("#fecha").datepicker({
            format: 'dd/mm/yyyy',
            language: 'es',
            autoclose: true,
            todayHighlight: true
        });

        $("#fecha").on("keyup", function () {
            var valor = $(this).val().replace(/\D/g, "").replace(/^(\d\d)(\d)/g, "$1/$2").replace(/\/(\d\d)(\d)/, "/$1/$2");
            $(this).val(valor.substring(0, 10));  // Limitar a 10 caracteres
        });

        $("#fecha").keypress(function (e) {
            // Permitir solo números y limitar a 10 caracteres (incluyendo '/')
            var charCode = (e.which) ? e.which : e.keyCode;
            if ($(this).val().length >= 10 && (charCode >= 48 && charCode <= 57)) {
                return false;
            } else if (charCode >= 48 && charCode <= 57) {
                return true;
            }
            return false;
        });

        // Evitar que se pegue texto no deseado
        $("#fecha").on('paste', function (e) {
            e.preventDefault();
        });

        // Inicializar Select2 Elements
        $('.select2').select2();

        // Inicializar Select2 Elements
        $('.select2bs4').select2({
            theme: 'bootstrap4'
        });

        var $btnFilter = $('#btn-filter');
        var $table = $('#tableContainer');

        $btnFilter.on('click', function (event) {
            event.preventDefault();

            var fecha = $('#fecha').val();
            var idAlmacen = $('#idAlmacen').val();

            // Validar campos
            var formData = {
                fecha: fecha,
                idAlmacen: idAlmacen,
            };

            $.ajax({
                url: '/user/filter-getsalesbycategories',
                type: 'POST',
                data: formData,
                success: function (data) {
                    console.log(data)

                    var content = ""
                    var totalVenta = 0
                    var totalComisiones = 0
                    var totalNetoVenta = 0

                    $.each(data, function (index, value) {
                        content += "<tr>"
                        content += "<td>" + value.Categoria + "</td>"
                        content += "<td>" + value.Venta + "</td>"
                        content += "<td>" + value.Comisiones + "</td>"
                        content += "<td>" + value.NetoVenta + "</td>"
                        content += "<td>" + value.Fecha + "</td>"
                        content += "</tr>"
                        totalVenta = totalVenta + value.Venta
                        totalComisiones = totalComisiones + value.Comisiones
                        totalNetoVenta = totalNetoVenta + value.NetoVenta
                    })

                    

                    $("#tableContainer tbody").html(content);
                    $("#totalVenta").html("$"+totalVenta.toFixed(2))
                    $("#totalComisiones").html("$"+totalComisiones.toFixed(2))
                    $("#totalNetoVenta").html("$"+totalNetoVenta.toFixed(2))


                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Error al filtrar/verificar filtrobusqueda');
                }
            });
        });


    })
    </script>

}