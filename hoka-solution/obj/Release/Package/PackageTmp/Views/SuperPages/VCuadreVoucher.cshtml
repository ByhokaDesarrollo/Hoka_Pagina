@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioAdminTotal","AdminPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>CUADRE VOUCHER</h1>
                        </div>
                    </div>
                </div>
                <hr />

                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        <div class="row">
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                <label for="fechaInicioR">Fecha</label>
                                <input type="text" id="fecha" name="fecha" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                            </div>
                            @*<div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaFinR">Fecha Fin</label>
                                    <input type="text" id="fechaFin" name="fechaFin" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>*@
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                <label for="fechaFinR">Almacen</label>
                                <select name="idAlmacen" class="form-control">
                                    <option value="value">Seleccionar</option>
                                    @foreach (var item in ViewBag.Almacenes)
                                    {
                                        <option value="@item.Item1">@item.Item2</option>
                                    }
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12 mt-2 mt-lg-0">
                                <label for="btn-filtrar">Filtrar</label>
                                <div>
                                    <button type="button" id="btnSearch" class="btn btn-info">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tableContainer">
                                <thead>
                                    <tr>
                                        <th>Voucher</th>
                                        <th>Cantidad</th>
                                        <th>Importe</th>
                                        <th>Recepcion</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                @*<tfoot>
                                    <th></th>
                                    <th></th>
                                    <th>Total:$</th>
                                    <th></th>
                                    </tfoot>*@
                            </table>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</body>
</html>
<!-- Modal -->
<div class="modal fade" id="containerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/super/caja-actualizar-cuadre-vouchers" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Información</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="idSummary" />
                    <input type="hidden" name="fecha" />
                    <input type="hidden" name="idAlmacen" />
                    <input type="hidden" name="idVoucher" />
                    <div class="form-group">
                        <input type="number" name="recepcion" class="form-control" />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

