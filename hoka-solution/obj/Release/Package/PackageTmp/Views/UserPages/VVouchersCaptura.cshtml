
@{
    ViewBag.Title = "REPORTE";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioUser", "UserPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion", "Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Vouchers</h1>
                        </div>
                    </div>
                </div>
                <hr />

                @if (ViewBag.ExistingRecord == true)
                {
                    <div class="card">
                        <!--Inicio de Botones del sidebar de la tabla de contenido-->
                        <div class="card-header">
                            @{
                                DateTime FechaReadOnly = DateTime.Now;
                                FechaReadOnly.ToString("yyyy-MM-dd");

                                foreach(var item in ViewBag.Vouchers)
                                {
                                    if (item.Id == Convert.ToInt32(ViewBag.IdVoucher))
                                    {
                                        @item.Nombre;
                                    }
                                }



                            }
                            <div class="row">
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaInicioR">Fecha</label>
                                    <input value="@FechaReadOnly.ToString("yyyy-MM-dd")" readonly class="form-control" />
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="table table-responsive">
                                    <table class="table table-striped" id="">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Importe</th>
                                                <th>Referencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ int counter = 0; }
                                            @foreach (var item in ViewBag.RegistroVouchers)
                                            {
                                                if (Convert.ToInt32(ViewBag.IdVoucher) == item.IdVoucher)
                                                {
                                                    counter++;
                                                    <tr>
                                                        <td>@counter</td>
                                                        <td>@item.Importe</td>
                                                        <td>@item.Referencia</td>
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                else
                {

                    <div class="card">
                        <div class="card-header">

                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm("procesarVoucher", "UserPages", FormMethod.Post))
                            {
                                <input type="hidden" name="IdVoucher" value="@ViewBag.IdVoucher" />
                                <table class="table table-bordered" id="tableVouchers">
                                    <thead>
                                        <tr>
                                            <th>Consecutivo</th>
                                            <th>Importe</th>
                                            <th>Referencia</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                                <a class="btn btn-primary" id="add">Agregar</a>
                                <button type="submit" class="btn btn-primary" id="btn-add-item" style="display:none">Guardar</button>
                            }
                        </div>
                    </div>
                }


                </section>
        </div>
    </div>


</body>
</html>
@section scripts {
    <script>
        
        var counter = 0;

        
        

        $("#add").on("click", function () { 

            $("#btn-add-item").slideDown()

            counter = counter + 1;
            $(".table tbody").append('<tr>' +
                '<td class="consecutivo">1</td>'+
                '<td class="importe"><input type="number" min="1" value="0" name="importe[' + counter + ']" value="0" class="form-control"/></td>' +
                '<td class="referencia"><input type="text" name="referencia[' + counter + ']" class="form-control"/></td>' +
                '<td><button type="button" class="btn btn-danger removebutton" title="Remove this row">X</button></td>'+
                '</tr>'
            ) 
        })

        $(document).on('click', 'button.removebutton', function () {
            $(this).closest('tr').remove();
           

            if ($("#tableVouchers tbody tr").length <1) {
                $("#btn-add-item").slideUp()
            }

            return false;

        });

    </script>
}