@model List<hoka.Models.AllHokaModels>

@using PagedList.Mvc;
@using System.Globalization


@{

    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewBag.Title</title>

    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
    <link href="~/Content/css/estilosdetallesticket.css" rel="stylesheet" />

    <!--para llamar el script tengo que cargarlo asi-->
    @*<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>*@
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="~/Scripts/ScriptsAdmins/ScriptDetalleTicketsAdminTotal.js"></script>  <!--cambiar nombre del script y crear uno nuevo-->


</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioUser","UserPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6 custom-container">
                            <h1>DETALLE DEL TICKET: @ViewBag.idFolio</h1>
                            <button type="submit" id="btn-filtrar" class="btn btn-danger" onclick="closeCurrentTab()">
                                <i class="far fa-window-close"></i>
                                <span class="d-none d-md-inline">Cerrar Detalle</span>
                            </button>
                        </div>




                    </div>
                </div>
                <hr />



                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        DETALLE DEL TIPO DE PAGO
                    </div>
                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaPagosM">
                                <thead>
                                    <tr>
                                        <th>Folio</th>
                                        <th>Total</th>
                                        <th>Tipo de pago</th>
                                        <th>Almacen</th>
                                        <th>Fecha de pago</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            foreach (var remisiopago in item.RemisioMPagoM)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrEmpty(remisiopago.folio_factura) ? "Sin registro de dato" : remisiopago.folio_factura)</td>
                                                    <td>@(remisiopago.total.HasValue ? remisiopago.total.Value.ToString("C", new CultureInfo("en-US")) : "Sin registro de dato")</td>
                                                    <td>@(string.IsNullOrEmpty(remisiopago.NombreMoneda) ? "Sin registro de dato" : remisiopago.NombreMoneda)</td>
                                                    <td>@(string.IsNullOrEmpty(remisiopago.NombreAlmacen) ? "Sin registro de dato" : remisiopago.NombreAlmacen)</td>
                                                    <td>@(remisiopago.fecha_pago.HasValue ? remisiopago.fecha_pago.Value.ToString("dd/MM/yyyy") : "Sin registro de dato")</td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>

                    </div>


                    <div class="card-header">
                        DETALLE PRODUCTOS
                    </div>
                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaProductosD">
                                <thead>
                                    <tr>
                                        <th>Folio</th>
                                        <th>Descripción</th>
                                        <th>Codigo de barra</th>
                                        <th>Almacen</th>
                                        <th>Uni. Vendidas</th>
                                        <th>Deportiva</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            foreach (var remisioproducto in item.RemisioDyMM)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrEmpty(remisioproducto.folio_factura) ? "Sin registro de dato" : remisioproducto.folio_factura)</td>
                                                    <td>@(string.IsNullOrEmpty(remisioproducto.descripcion_larga) ? "Sin registro de dato" : remisioproducto.descripcion_larga)</td>
                                                    <td>@(string.IsNullOrEmpty(remisioproducto.codigo_barras) ? "Sin registro de dato" : remisioproducto.codigo_barras)</td>
                                                    <td>@(string.IsNullOrEmpty(remisioproducto.NombreAlmacen) ? "Sin registro de dato" : remisioproducto.NombreAlmacen)</td>
                                                    <td>@(remisioproducto.cantidads.HasValue ? remisioproducto.cantidads.Value.ToString() : "Sin registro de dato")</td>
                                                    <td>@(string.IsNullOrEmpty(remisioproducto.deportiva) ? "Sin registro de dato" : remisioproducto.deportiva)</td>
                                                    <td>@(remisioproducto.fecha.HasValue ? remisioproducto.fecha.Value.ToString("dd/MM/yyyy") : "Sin registro de dato")</td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                        <!--SCRIPT-->
                    </div>

                    <div class="card-header">
                        DETALLE VENDEDORES
                    </div>
                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaVendedoresM">
                                <thead>
                                    <tr>
                                        <th>Folio</th>
                                        <th>Vendedor</th>
                                        <th>Almacen</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            foreach (var remisiovendedor in item.RemisioMVendedorM)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrEmpty(remisiovendedor.folio_factura) ? "Sin registro de dato" : remisiovendedor.folio_factura)</td>
                                                    <td>@(string.IsNullOrEmpty(remisiovendedor.NombreVendedor) ? "Sin registro de dato" : remisiovendedor.NombreVendedor)</td>
                                                    <td>@(string.IsNullOrEmpty(remisiovendedor.NombreAlmacen) ? "Sin registro de dato" : remisiovendedor.NombreAlmacen)</td>
                                                    <td>@(remisiovendedor.fecha.HasValue ? remisiovendedor.fecha.Value.ToString("dd/MM/yyyy") : "Sin registro de dato")</td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                        <!--SCRIPT-->
                    </div>

                    <div class="card-header">
                        OBSERVACIONES
                    </div>
                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaObservacionesM">
                                <thead>
                                    <tr>
                                        <th>Folio</th>
                                        <th>Observación</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            foreach (var observacionesM in item.RemisioMM)
                                            {
                                                <tr>
                                                    <td>@observacionesM.folio_factura</td>
                                                    <td>@(string.IsNullOrEmpty(observacionesM.observaciones) ? "Sin observaciones" : observacionesM.observaciones)</td>

                                                    <td>@observacionesM.fecha.ToString("dd/MM/yyyy")</td>

                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!--SCRIPT-->
                    </div>


                    <!--aqui termina la tabla-->
                </div>
            </section>
        </div>
    </div>
</body>
</html>
