                            @section scripts {
                                <script>
                                    $(document).ready(function () {

                                        function totalcomisionesclave() {
                                            var acu = 0
                                            $(".comisionesclaves-input").each(function () {
                                                var valor = $(this).val()

                                                if (valor == null || valor == "")
                                                    valor = 0

                                                acu = parseFloat(acu) + parseFloat(valor)
                                                console.log(acu)
                                                console.log($(this).val())
                                            });

                                            $("#totalcomisiones").html("$" + parseFloat(acu).toFixed(2))
                                        }

                                        function totalnetoventa() {

                                            console.log("totalnetoventa")

                                            var acu = 0
                                            $(".comisionesclaves-input").each(function (index) {
                                                console.log("index", index)
                                                var valor = $(this).val()

                                                if (valor == null || valor == "")
                                                    valor = 0;

                                                var valor2 = $("#item" + (index + 1)).find("#venta").attr("data-amount")

                                                //
                                                $("#item" + (index + 1)).find(".comision-input-hidden").val(valor)

                                                console.log($("#item" + (index + 1)).find(".comision-input-hidden").val())

                                                var f1 = valor2 - valor

                                                $("#item" + (index + 1) + " #netoventa").attr("data-amount", f1)
                                                $("#item" + (index + 1) + " #netoventa").html("$" + f1)
                                                console.log("cal", f1)

                                                $("#item" + (index + 1)).find(".comision-input-hidden").val(valor)
                                                $("#item" + (index + 1)).find(".netoventa-input-hidden").val(f1)



                                                acu = parseFloat(acu) + parseFloat(f1)

                                                console.log(acu)
                                                console.log($(this).val())
                                            });

                                            $("#totalnetoventa").html("$" + parseFloat(acu).toFixed(2))

                                            ///


                                        }

                                        $(".calcular").on("click", function () {

                                            var id = $(this).attr("data-id")

                                            var t2 = 0
                                            t2 = $("#item" + id).find("#venta").attr("data-amount")

                                            if (t2 == null || t2 == "")
                                                t2 = 0

                                            var t3 = $("#item" + id).find("#comisiones input").val()
                                            if (t3 == null || t3 == "")
                                                t3 = 0

                                            $("#item" + id).find("#netoventa").html("$" + (parseFloat(t2).toFixed(2) - parseFloat(t3).toFixed(2)).toFixed(2).toString())

                                            totalcomisionesclave()
                                            totalnetoventa()

                                        })



                                        //Aqui empieza la tabla

                                        var $filtrarBusqueda = $('#filtrarBusqueda');
                                        var $tablaVAlmacen = $('#tablaVAlmacen');

                                        // modificaciones de los selects fecha

                                        $("#fecha").datepicker({
                                            format: 'dd/mm/yyyy',
                                            language: 'es',
                                            autoclose: true,
                                            todayHighlight: true
                                        });

                                        $("#fecha").on("keyup", function () {
                                            var valor = $(this).val().replace(/\D/g, "").replace(/^(\d\d)(\d)/g, "$1/$2").replace(/\/(\d\d)(\d)/, "/$1/$2");
                                            $(this).val(valor.substring(0, 10));  // Limitar a 10 caracteres
                                        });

                                        $("#fecha").keypress(function (e) {
                                            // Permitir solo números y limitar a 10 caracteres (incluyendo '/')
                                            var charCode = (e.which) ? e.which : e.keyCode;
                                            if ($(this).val().length >= 10 && (charCode >= 48 && charCode <= 57)) {
                                                return false;
                                            } else if (charCode >= 48 && charCode <= 57) {
                                                return true;
                                            }
                                            return false;
