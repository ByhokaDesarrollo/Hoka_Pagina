
@{
    ViewBag.Title = "GProductosAdmin";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">

    <!--===============================================================================================-->
    <link rel="icon" type="image/png" href="~/Content/img/icons/BLANCO.png" />
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Content/vendor/bootstrap/css/bootstrap.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Content/fonts/font-awesome-4.7.0/css/font-awesome.min.css">

    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Content/vendor/animate/animate.css">
    <!--===============================================================================================-->
    <!-- <link rel="stylesheet" type="text/css" href="vendor/css-hamburgers/hamburgers.min.css"> -->
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Content/vendor/select2/select2.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="~/Content/css/utilC.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/mainC.css">
    <!--===============================================================================================-->


</head>
<body>

    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="@Url.Action("InicioAdmin", "AdminPages")" class="nav-link">Inicio</a>
                </li>

            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!--AQUI VA PARA AUMENTAR LA PANTALLA-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("CerrarSesion","Acceso")" class="nav-link">Salir</a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        @*CONTENIDO*@
        <div class="limiter">
            <!--Inicio de titulo-->

            <div class="container-login100">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Graficas</h1>
                        </div>
                    </div>
                </div>
                <div class="wrap-login100">

                    <div class="login100-pic js-tilt" data-tilt>
                        <img src="~/Content/img/icons/build2.png" alt="IMG">
                    </div>

                    <form id="form-accesodenegado" class="login100-form validate-form">

                        <span class="login100-form-title">
                            Lamentamos las molestias! Esta pagina esta en contrucción.
                        </span>

                        <p style="color:lightslategray;">
                            Esto se debe a que la pagina no se ha actualizado para su uso, gracias por la comprensión.
                        </p>

                    </form>

                </div>
            </div>
        </div>

        <!--===============================================================================================-->
        <script src="~/Content/vendor/jquery/jquery-3.2.1.min.js"></script>
        <!--===============================================================================================-->
        <script src="~/Content/vendor/bootstrap/js/popper.js"></script>
        <script src="~/Content/vendor/bootstrap/js/bootstrap.min.js"></script>
        <!--===============================================================================================-->
        <script src="~/Content/vendor/select2/select2.min.js"></script>
        <!--===============================================================================================-->
        <script src="~/Content/vendor/tilt/tilt.jquery.min.js"></script>
        <script>
            $('.js-tilt').tilt({
                scale: 1.1
            })
        </script>
        <!--===============================================================================================-->
        <script src="~/Content/js/main.js"></script>
        <script src="~/Scripts/sweetalert2.all.min.js"></script>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>

</body>
</html>




