@model hoka.Models.AllModels


@{
    ViewBag.Title = "EditarCotraseña";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
</head>
<body>

    <div class="wrapper">

        <!-- Navbar -->

        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="#" class="nav-link">Inicio</a>
                </li>

            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!--AQUI VA PARA AUMENTAR LA PANTALLA-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("CerrarSesion","Acceso")" class="nav-link">Salir</a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        @*CONTENIDO*@
        <div class="content-header">
            @*CONTENIDO*@
            <section class="content-header">
                @*TITULO DEL AREA*@
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>EDITAR CONTRASEÑA DEL USUARIO</h1>
                        </div>
                    </div>
                </div><!-- /.container-fluid -->
                <hr />
                <div class="card">
                    <div class="card-body">
                        <div class="table table-responsive">
                            <div class="panel-body">
                                <form id="form-editarcontra" method="post" action="@Url.Action("EditarContraseña", "AdminPages", new { idUsuario = Model.UsuarioMNoList.Id_Usuario})">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="login-box-msg">Datos Personales</p>
                                            <!-- DATOS PERSONALES DE LOS USUARIOS POR EDITAR -->

                                            <input type="hidden" id="Id_Usuario" name="Id_Usuario" value="@Model.UsuarioMNoList.Id_Usuario" />

                                            <label for="NombreU">Nombre:</label>
                                            <div class="input-group mb-3">
                                                <input type="text" class="form-control" id="NombreU" name="NombreU" value="@Model.UsuarioMNoList.NombreU" placeholder="Nombre: Ej. Juan" disabled>
                                                <div class="input-group-append">
                                                    <div class="input-group-text">
                                                        <span class="fas fa-user"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <label for="ApellidoU">Apellido:</label>
                                            <div class="input-group mb-3">
                                                <input type="text" class="form-control" id="ApellidoU" name="ApellidoU" value="@Model.UsuarioMNoList.ApellidoU" placeholder="Apellido: Ej. Lopez" disabled>
                                                <div class="input-group-append">
                                                    <div class="input-group-text">
                                                        <span class="fas fa-user"></span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <!-- HACER UNA DIVISION EN EL HTML O CSS PARA UNA MEJOR VISUALIZACION -->
                                        <!-- DATOS GENERALES DE LOS USUARIOS -->
                                        <div class="col-md-6">
                                            <p class="login-box-msg">Datos de usuario</p>

                                            <label for="Correo">Correo:</label>
                                            <div class="input-group mb-3">
                                                <input type="email" class="form-control" id="Correo" name="Correo" value="@Model.UsuarioMNoList.Correo" placeholder="Correo" disabled autocomplete="off">
                                                <div class="input-group-append">
                                                    <div class="input-group-text">
                                                        <span class="fas fa-envelope"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <label for="Clave">Clave:</label>
                                            <div class="input-group mb-3">
                                                <input type="password" class="form-control" id="Clave" name="Clave" value="@Model.UsuarioMNoList.Clave" placeholder="Contraseña" autocomplete="new-password">
                                                <div class="input-group-append">
                                                    <div class="input-group-text">
                                                        <span class="fas fa-lock"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <label for="ConfirmarClave">Confirmar Clave:</label>
                                            <div class="input-group mb-3">
                                                <input type="password" class="form-control" id="ConfirmarClave" name="ConfirmarClave" value="@Model.UsuarioMNoList.ConfirmarClave" placeholder="Confirmar Contraseña">
                                                <div class="input-group-append">
                                                    <div class="input-group-text">
                                                        <span class="fas fa-lock"></span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <a class="btn btn-warning btn-block" href="@Url.Action("LUsuariosAdminTotal","AdminPages")">Volver</a>
                                            </div>
                                            <div class="col-md-6">
                                                <button id="btn-editarcontra" type="submit" class="btn btn-primary btn-block">Actualizar</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!--por lo general se pone el boton aqui -->
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.card -->
            </section>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="~/Scripts/ScriptsAdmins/ScriptEditarContraseñaAdminTotal.js"></script>
</body>
</html>


