@model hoka.Models.AllModels

@{
    ViewBag.Title = "EditarPerfil";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <link href="~/Content/css/EditarAdmin.css" rel="stylesheet" />
    <style>
        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            -moz-appearance: textfield;
        }
    </style>


</head>
<body>

    <div class="wrapper">

        <!-- Navbar -->

        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="#" class="nav-link">Inicio</a>
                </li>

            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!--AQUI VA PARA AUMENTAR LA PANTALLA-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("CerrarSesion", "Acceso")" class="nav-link">Cerrar Sesión</a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        @*CONTENIDO*@
        <div class="content-header">
            @*CONTENIDO*@
            <section class="content-header">
                @*TITULO DEL AREA*@
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>ACTUALIZAR PERFIL</h1>
                        </div>
                    </div>
                </div><!-- /.container-fluid -->
                <hr />
                <div class="card">
                    <div class="card-body">
                        <div class="table table-responsive">
                            <div class="panel-body">
                                <!--Aqui inicia como reaccionara el controlador-->
                                <form id="form-editar" method="post" action="@Url.Action("EditarPerfil", "AdminPages", new { idPerfil = Model.PerfilMNoList.Id_Perfil })">
                                    <div class="row">
                                        <input type="hidden" id="Id_Perfil" name="Id_Perfil" value="@Model.PerfilMNoList.Id_Perfil" />

                                        <label for="NombreU">Nombre:</label>
                                        <div class="input-group mb-3">
                                            <input type="text" class="form-control" id="Nombre_Perfil" name="Nombre_Perfil" value="@Model.PerfilMNoList.Nombre_Perfil" placeholder="Ejem. Gerente, Vendedor, Etc.">
                                            <div class="input-group-append">
                                                <div class="input-group-text">
                                                    <span class="fas fa-user"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <label for="Perfil">Selecciona el perfil:</label>
                                        <div class="input-group mb-3">
                                            <select class="form-control select2 rol-select-editar" style="width: 100%" id="Id_Rol" name="Id_Rol">
                                                <option selected="selected">Selecciona un Rol</option>
                                                @foreach (var rol in Model.RolesM)
                                                {
                                                    <option value="@rol.Id_Rol" @(Model.PerfilMNoList.Id_Rol == rol.Id_Rol ? "selected" : "")>@rol.Nombre_Rol</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <a class="btn btn-warning btn-block" href="@Url.Action("PerfilesForUsersAdminTotal","AdminPages")">Volver</a>
                                        </div>
                                        <div class="col-md-6">
                                            <button id="btn-editar" type="submit" class="btn btn-primary btn-block">Actualizar</button>
                                        </div>
                                    </div>
                                    <!--por lo general se pone el boton aqui -->
                                </form>
                            </div>


                        </div>
                    </div>
                </div>
                <!-- /.card -->
            </section>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>

    <script src="~/Scripts/ScriptsAdmins/ScriptEditarPerfilAdminTotal.js"></script>
</body>
</html>

