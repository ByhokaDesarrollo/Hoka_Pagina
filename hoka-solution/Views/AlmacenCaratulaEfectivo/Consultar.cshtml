@using hoka.HokaCli.Models.Compuadmo.Moneda;
@using hoka.HokaCli.Models.Compuadmo.Usuario;
@using hoka.HokaCli.Models.Compuadmo.Usuario.Permiso.AlmacenCaratula;
@using hoka.HokaCli.Models.Ingresos.AlmacenCaratula;
@using hoka.HokaCli.Models.Ingresos.AlmacenCaratulaEfectivo;
@using System.Globalization;
@{
    ViewBag.Title = "Consultar";
    EnUsuario Usuario = ViewBag.Usuario;
    string layoutUsuario =
        Usuario.UsuarioRol.Prefijo == "ADMT"
            ? "_LayoutAdminTotal.cshtml" :
            Usuario.UsuarioRol.Prefijo == "ADM"
                ? "_LayoutAdmin.cshtml"
                : "_LayoutUser.cshtml";
    Layout = $"~/Views/Shared/{layoutUsuario}";
    string tituloFondoColor = "#9c8050";
    string tituloTexto = "CARÁTULA EFECTIVO (CONSULTAR)";
    string tituloTextoColor = "#fff";
    string tablaEncabezadoFondoColor = "#f3f3f3";
    string buttonFooterAncho = "width:220px;";
    EnAlmacenCaratula Caratula = ViewBag.Caratula;
    EnUsuarioPermisoAlmacenCaratula PermisoCaratula = ViewBag.PermisoCaratula;
    EnAlmacenCaratulaEfectivo CaratulaEfectivo = ViewBag.AlmacenCaratulaEfectivo;
    ICollection<EnMoneda> MonedasDenominacion = ViewBag.MonedasDenominacion;
    List<EnMoneda> ListaMonedas = MonedasDenominacion
        .Select
        (
            x => new EnMoneda
            {
                MonedaId = x.MonedaId,
                Nombre = x.Nombre,
                Valor = x.Valor
            }
        )
        .Distinct()
        .OrderBy
        (
            x => x.MonedaId
        )
        .ToList();
    //string jsonMonedas = Html.Raw(JsonConvert.SerializeObject(MonedasDenominacion));
    string prefijoPesos = "MXN";
    string importeEfectivoTotalId = "ImporteEfectivoTotal";
    string claseTotales = "ImportesTotales";
}

<style>
</style>

<div class="container-fluid">
    @*Título*@
    <div class="row mb-2">
        <div class="col text-center"
             style="background-color: @(tituloFondoColor); color: @(tituloTextoColor)">
            <strong>
                @tituloTexto
            </strong>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="card ml-2 mr-2 p-2">
        @*Acciones*@
        <div class="row mb-1">
            <div class="col">

                @*FILA PARA BOTONES*@

                @*<a role="button" class="btn btn-success btn-sm">
                        <i class="bi bi-clipboard-plus-fill"></i>
                        Nuevo Registro
                    </a>*@
            </div>
        </div>
        <div class="row mb-1">
            <div class="col text-center">
                @*Tabla MonedasDenominacion*@
                <table class="table table-responsive table-sm table table-bordered"
                       id="tabla_Moneda">
                    <thead>
                        <tr>
                            <th colspan="3"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Efectivo
                            </th>
                        </tr>
                        <tr>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Denominación</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Cantidad</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var moneda in CaratulaEfectivo.Monedas.OrderBy(x => x.MonedaId)) //ListaMonedas
                        {
                            string monedaDenominacionImporteClase = "MonedaId" + moneda.MonedaId;
                            <tr data-es-denominacion=false>
                                <td colspan="3">
                                    @moneda.Moneda.Nombre
                                </td>
                            </tr>
                            foreach (var denominacion in moneda.Denominaciones)
                            {
                                string monedaDenominacionCantidadId = "MonedaDenominacionIdCantidad" + denominacion.MonedaDenominacionId;
                                string monedaDenominacionImporteId = "MonedaDenominacionIdImporte" + denominacion.MonedaDenominacionId;
                                string textoDenominacionImporte = denominacion.Importe.ToString("C", CultureInfo.CurrentCulture);
                                <tr class="moneda-denominacion">
                                    @*Denominación*@
                                    <td>
                                        @denominacion.MonedaDenominacion.Denominacion
                                    </td>
                                    @*Cantidad*@
                                    <td>
                                        <input type="number"
                                               class=""
                                               id="@monedaDenominacionCantidadId"
                                               name="campo_cantidad"
                                               value="@denominacion.Cantidad"
                                               disabled />
                                    </td>
                                    @*Importe*@
                                    <td>
                                        <input type="text"
                                               class="text-right formato-numerico @monedaDenominacionImporteClase"
                                               id="@monedaDenominacionImporteId"
                                               name="campo_importe"
                                               value="@textoDenominacionImporte"
                                               disabled />
                                    </td>
                                </tr>
                            }
                        }
                    <tbody>
                    <tfoot>
                        <tr>
                            <th scope="row"
                                colspan="3"
                                style="background-color: @(tablaEncabezadoFondoColor);">Cuadre Efectivo</th>
                        </tr>
                        <tr>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Moneda</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Importe Moneda Origen</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Importe MXN</th>
                        </tr>
                        @foreach (var moneda in CaratulaEfectivo.Monedas.OrderBy(x => x.MonedaId)) //ListaMonedas
                        {
                            string monedaDenominacionImporteId = "MonedaId" + moneda.MonedaId;
                            string monedaDenominacionImporteIdMXN = "MonedaId" + moneda.MonedaId + @prefijoPesos;

                            string textoMonedaImporte = moneda.ImporteTotal.ToString("C", CultureInfo.CurrentCulture);
                            string textoMonedaImporteMXN = moneda.ImporteTotalMXN.ToString("C", CultureInfo.CurrentCulture);
                            <tr>
                                @*Moneda*@
                                <th scope="row">@moneda.Moneda.Nombre</th>
                                @*Importe Moneda Origen*@
                                <td>
                                    <input type="text"
                                           class="text-right formato-numerico"
                                           id="@monedaDenominacionImporteId"
                                           name="campo_importe"
                                           value="@textoMonedaImporte"
                                           disabled />
                                </td>
                                @*Importe MXN*@
                                <td>
                                    <input type="text"
                                           class="text-right formato-numerico @claseTotales"
                                           id="@monedaDenominacionImporteIdMXN"
                                           name="campo_importe"
                                           value="@textoMonedaImporteMXN"
                                           disabled />
                                </td>
                            </tr>
                        }
                        <tr>
                            @{
                                string textoImporteTotalMXN = CaratulaEfectivo.ImporteTotal.ToString("C", CultureInfo.CurrentCulture);
                            }
                            <th scope="row"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Total Efectivo
                            </th>
                            <td style="background-color: @(tablaEncabezadoFondoColor);"></td>
                            @*Total Efectivo*@
                            <td style="background-color: @(tablaEncabezadoFondoColor);">
                                <input type="text"
                                       class="text-right formato-numerico"
                                       id="@importeEfectivoTotalId"
                                       name="campo_importe_mxn"
                                       value="@textoImporteTotalMXN"
                                       disabled />
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col text-center">
                <a class="btn btn-sm btn-secondary"
                   href="@ViewBag.UrlIndexAlmacenCaratula"
                   role="button"
                   style="@buttonFooterAncho">
                    <i class="bi bi-house-door-fill"></i>
                    Gestor Ventas
                </a>
            </div>
        </div>
    </div>
</div>