@using hoka.HokaCli.Models.Ingresos.AlmacenCaratula;
@using hoka.HokaCli.Models.Ingresos.AlmacenCaratulaVenta;
@using hoka.HokaCli.Models.Compuadmo.AlmacenCategoriaVenta;
@using hoka.HokaCli.Models.Compuadmo.Usuario.Permiso.AlmacenCaratula;
@using System.Globalization;
@{
    ViewBag.Title = "Actualizar";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    string tituloFondoColor = "#9c8050";
    string tituloTexto = "CARÁTULA VENTA (ACTUALIZAR)";
    string tituloTextoColor = "#fff";
    string idTablaVenta = "idTablaVenta";
    string tablaEncabezadoFondoColor = "#f3f3f3";
    string ventaDiferenciaFondoColorPositivo = "#399d72";
    string ventaDiferenciaFondoColorNegativo = "#cb4141";
    string buttonFooterAncho = "width:220px;";
    string controladorCaratulaEfectivo = ViewBag.TextoCaratulaEfectivo;
    EnAlmacenCaratula Caratula = ViewBag.Caratula;
    EnUsuarioPermisoAlmacenCaratula PermisoCaratula = ViewBag.PermisoCaratula;
    ICollection<EnAlmacenCategoriaVenta> AlmacenCategoriasVenta = ViewBag.AlmacenCategoriasVenta;
    EnAlmacenCaratulaVenta AlmacenCaratulaVenta = ViewBag.AlmacenCaratulaVenta;
    string ventaDiferenciaFondoColor =
        AlmacenCaratulaVenta.VentaNetaTotal > AlmacenCaratulaVenta.VentaSistemaTotal
            ? "#399d72"
            : "#cb4141";
    string textoVentaNetaTotal = AlmacenCaratulaVenta
        .VentaNetaTotal.ToString("C", CultureInfo.CurrentCulture);
    string textoVentaSistemaTotal = AlmacenCaratulaVenta
        .VentaSistemaTotal.ToString("C", CultureInfo.CurrentCulture);
    string textoVentaDiferencia = AlmacenCaratulaVenta
        .VentaDiferencia.ToString("C", CultureInfo.CurrentCulture);
    string idVentaSistemaTotal = "idVentaSistemaTotal";
    string idVentaNetaTotal = "idVentaNetaTotal";
    string idVentaDiferencia = "idVentaDiferencia";
    string classVentaNeta = "classVentaNeta";
}

<style>
</style>

<div class="container-fluid">
    @*Título*@
    <div class="row mb-2">
        <div class="col text-center"
             style="background-color: @(tituloFondoColor); color: @(tituloTextoColor)">
            <strong>
                @tituloTexto
            </strong>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card ml-2 mr-2 p-2">
        @*Acciones*@
        <div class="row mb-2">
            <div class="col">
                @*FILA PARA BOTONES*@
            </div>
        </div>
        <div class="row mb-2">
            <div class="col text-center">
                <table class="table table-responsive table-sm table table-bordered"
                       id="@idTablaVenta">
                    <thead>
                        <tr>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Categoria</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Venta</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Venta Neta</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Comisiones Clave</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var almacenCategoriaVenta in ViewBag.AlmacenCategoriasVenta)
                        {
                            int AlmacenCaratulaVentaCategoriaId = AlmacenCaratulaVenta
                                .Categorias
                                .Where(
                                    q =>
                                    q.CategoriaId == almacenCategoriaVenta.CategoriaId)
                                .FirstOrDefault()
                                .AlmacenCaratulaVentaCategoriaId;
                            decimal ventaNeta = AlmacenCaratulaVenta
                                .Categorias
                                .Where(
                                    q =>
                                    q.CategoriaId == almacenCategoriaVenta.CategoriaId)
                                .FirstOrDefault()
                                .VentaNeta;
                            decimal comision = AlmacenCaratulaVenta
                                .Categorias
                                .Where(
                                    q =>
                                    q.CategoriaId == almacenCategoriaVenta.CategoriaId)
                                .FirstOrDefault()
                                .Comision;
                            string textoCategoriaVenta = almacenCategoriaVenta.ImporteTotal.ToString("C", CultureInfo.CurrentCulture);
                            <tr>
                                <td width="300"
                                    data-id="@AlmacenCaratulaVentaCategoriaId"
                                    data-categoria-id="@almacenCategoriaVenta.CategoriaId">
                                    @almacenCategoriaVenta.Categoria.Nombre
                                </td>
                                <td class="text-right"
                                    width="200">
                                    @textoCategoriaVenta
                                </td>
                                <td width="200">
                                    <input type="number"
                                           class="@classVentaNeta text-right"
                                           name="ventaNeta"
                                           onchange="actualizarTotales(this)"
                                           value="@ventaNeta" />
                                </td>
                                <td width="200">
                                    <input type="number"
                                           class="text-right"
                                           id="comisionesClave"
                                           name="comisionesClave"
                                           onchange="actualizarTotales(this)"
                                           value="@comision" />
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Venta Neta Total
                            </th>
                            <td class="text-right"
                                id="@idVentaNetaTotal"
                                style="background-color: @(tablaEncabezadoFondoColor);"
                                colspan="3">
                                @textoVentaNetaTotal
                            </td>
                        </tr>
                        <tr>
                            <th scope="row"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Venta Sistema Total
                            </th>
                            <td class="text-right"
                                style="background-color: @(tablaEncabezadoFondoColor);"
                                id="@idVentaSistemaTotal"
                                colspan="3">
                                @textoVentaSistemaTotal
                            </td>
                        </tr>
                        <tr>
                            <th scope="row"
                                style="background-color: @(tablaEncabezadoFondoColor)">
                                Diferencia
                            </th>
                            <td class="text-right"
                                id="@idVentaDiferencia"
                                style="background-color: @(ventaDiferenciaFondoColor);"
                                colspan="3">
                                @textoVentaDiferencia
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col text-center">
                <a class="btn btn-sm btn-secondary"
                   href="@ViewBag.UrlIndexAlmacenCaratula"
                   role="button"
                   style="@buttonFooterAncho">
                    <i class="bi bi-house-door-fill"></i>
                    Gestor Ventas
                </a>
                @if (PermisoCaratula.B_CaratulaVentaActualizar)
                {
                    <button type="button"
                            class="btn btn-sm btn-success"
                            style="@buttonFooterAncho"
                            onclick="AlmacenCaratulaVentaActualizar()">
                        <i class="bi bi-floppy2-fill"></i>
                        Guardar
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript"
            src="~/Scripts/app/fx-decimal.js">
    </script>
    <script type="text/javascript">
        let inputVentaSistemaTotal = document.getElementById("@idVentaSistemaTotal");
        let inputVentaNetaTotal = document.getElementById("@idVentaNetaTotal");
        let inputVentaDiferencia = document.getElementById("@idVentaDiferencia");

        function actualizarTotales(input) {
            if (input.value.length === 0)
                input.value = 0;
            inputsVentaNetaCaptura = document.getElementsByClassName("@classVentaNeta");
            let VentaNetaTotal = parseFloat(0);
            for (let inputVentaNeta of inputsVentaNetaCaptura) {
                VentaNetaTotal += parseFloat(inputVentaNeta.value);
            }
            inputVentaNetaTotal.innerText = agregarFormatoMoneda(VentaNetaTotal);
            let ventaNetaTotal = quitarFormatoMoneda(inputVentaNetaTotal.innerText);
            let ventaSistemaTotal = quitarFormatoMoneda(inputVentaSistemaTotal.innerText);
            let ventaDiferencia = ventaNetaTotal - ventaSistemaTotal;
            inputVentaDiferencia.innerText = agregarFormatoMoneda(ventaDiferencia);
            inputVentaDiferencia.style.backgroundColor = ventaDiferencia >= 0
                ? '@(ventaDiferenciaFondoColorPositivo)'
                : '@(ventaDiferenciaFondoColorNegativo)';
        }

        function AlmacenCaratulaVentaActualizar() {
            let UrlAlmacenCaratulaVenta = '@(ViewBag.UrlAlmacenCaratulaVentaActualizar)';
            let AlmacenCaratulaVenta = ObtenerAlmacenCaratulaVenta();
            let bodyData = JSON.stringify(AlmacenCaratulaVenta);
            fetch(UrlAlmacenCaratulaVenta, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: bodyData
            })
            .then((res) => res.text())
            .then((data) => {
                if (data != 'error') {
                    window.location.replace(data);
                } else {
                    console.log('error');
                }
            });
        }

        function ObtenerAlmacenCaratulaVenta() {
            let ventaSistemaTotal = quitarFormatoMoneda(inputVentaSistemaTotal.innerText);
            let ventaNetaTotal = quitarFormatoMoneda(inputVentaNetaTotal.innerText);
            let ventaDiferencia = quitarFormatoMoneda(inputVentaDiferencia.innerText);
            ventaSistemaTotal = convertirValorDecimal(ventaSistemaTotal);
            ventaNetaTotal = convertirValorDecimal(ventaNetaTotal);
            ventaDiferencia = convertirValorDecimal(ventaDiferencia);
            let AlmacenCaratulaVenta = {
                AlmacenCaratulaVentaId: parseInt(@AlmacenCaratulaVenta.AlmacenCaratulaVentaId),
                AlmacenCaratulaId: parseInt(@Caratula.AlmacenCaratulaId),
                UsuarioId: parseInt(@Caratula.UsuarioId),
                FechaCaptura: null,
                VentaSistemaTotal: convertirValorDecimal(ventaSistemaTotal),
                VentaNetaTotal: convertirValorDecimal(ventaNetaTotal),
                VentaDiferencia: convertirValorDecimal(ventaDiferencia),
            };
            AlmacenCaratulaVenta.Categorias = ObtenerAlmacenCaratulaVentaCategorias();
            return AlmacenCaratulaVenta;
        }

        function ObtenerAlmacenCaratulaVentaCategorias() {
            let CategoriasVenta = [];
            let TablaVenta = document.getElementById('@(idTablaVenta)');
            let TBody = TablaVenta.getElementsByTagName('tbody')[0];
            let TRows = TBody.children;
            for (var i = 0; i < TRows.length; i++) {
                let CategoriaVenta = {
                    AlmacenCaratulaVentaCategoriaId: 0,
                    AlmacenCaratulaVentaId: parseInt(@AlmacenCaratulaVenta.AlmacenCaratulaVentaId)
                };
                let Fila = TRows[i].children;
                for (var ii = 0; ii < Fila.length; ii++) {
                    if (ii == 0) {
                        CategoriaVenta.AlmacenCaratulaVentaCategoriaId = parseInt(Fila[ii].dataset.id);
                        CategoriaVenta.CategoriaId = parseInt(Fila[ii].dataset.categoriaId);
                    }
                    if (ii == 1) {
                        let ventaSistema = quitarFormatoMoneda(Fila[ii].innerHTML);
                        ventaSistema = convertirValorDecimal(ventaSistema);
                        CategoriaVenta.VentaSistema = convertirValorDecimal(ventaSistema);
                    }
                    if (ii == 2) {
                        CategoriaVenta.VentaNeta = parseFloat(Fila[ii].children[0].value);
                    }
                    if (ii == 3) {
                        CategoriaVenta.Comision = parseFloat(Fila[ii].children[0].value);
                    }
                }
                CategoriasVenta.push(CategoriaVenta);
            }
            return CategoriasVenta;
        }

        function AlmacenCaratulaVentaGrabar() {
            let UrlAlmacenCaratulaVenta = '@(ViewBag.UrlAlmacenCaratulaVentaGrabar)';
            let AlmacenCaratulaVenta = ObtenerAlmacenCaratulaVenta();
            let bodyData = JSON.stringify(AlmacenCaratulaVenta);
            fetch(UrlAlmacenCaratulaVenta, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: bodyData
            })
            .then((res) => res.text())
            .then((data) => {
                if (data != 'error') {
                    window.location.replace(data);
                } else {
                    console.log('error');
                }
            });
        }
    </script>
}
