@model ICollection<hoka.HokaCli.Models.Ingresos.AlmacenCaratula.EnAlmacenCaratula>
@using hoka.HokaCli.Models.Compuadmo.Usuario;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    DateTime FechaActual = ViewBag.FechaActual;
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    EnUsuario Usuario = ViewBag.Usuario;
    string TextoCaratulaVenta = ViewBag.TextoCaratulaVenta;
    string TextoCaratulaEfectivo = ViewBag.TextoCaratulaEfectivo;
    string TextoCaratulaVoucher = ViewBag.TextoCaratulaVoucher;
    string TextoCaratulaReporte = ViewBag.TextoCaratulaReporte;
    string tituloFondoColor = "#9c8050";
    string tituloTexto = "GESTOR CARATULA";
    string tituloTextoColor = "#fff";
    string tablaEncabezadoFondoColor = "#f3f3f3";
    string idTableAlmacenCaratula = "idTableAlmacenCaratula";
}
<div class="container-fluid">
    @*Título*@
    <div class="row mb-2">
        <div class="col text-center"
             style="background-color: @(tituloFondoColor); color: @(tituloTextoColor)">
            <strong>
                @tituloTexto
            </strong>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="card ml-2 mr-2 p-2">
        @*Acciones*@
        <div class="row mb-1">
            <div class="col">
                @*FILA PARA BOTONES*@
            </div>
        </div>
        @*Caratulas*@
        <div class="row">
            <div class="col text-center">
                <table id="@idTableAlmacenCaratula"
                       class="table table-sm table-responsive display"
                       style="margin-right: auto; margin-left: auto; ">
                    <thead>
                        <tr>
                            <th class="text-center"
                                width="150"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Fecha
                            </th>
                            <th class="text-center"
                                width="200"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Estado
                            </th>
                            <th class="text-center"
                                width="200"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Ciudad
                            </th>
                            <th class="text-center"
                                width="200"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Sucursal
                            </th>
                            <th class="text-center"
                                width="180"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Folio
                            </th>
                            <th class="text-center"
                                width="180"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Estatus
                            </th>
                            <th class="text-center"
                                width="200"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Usuario
                            </th>
                            <th class="text-center"
                                width="150"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Ventas
                            </th>
                            <th class="text-center"
                                width="150"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Efectivo
                            </th>
                            <th class="text-center"
                                width="150"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Vouchers
                            </th>
                            <th class="text-center"
                                width="150"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Caratula
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Count > 0)
                        {
                            foreach (var caratula in Model)
                            {
                                var PermisoAlmacenCaratula = Usuario
                                    .Permiso
                                    .PermisosAlmacenCaratula
                                    .Where(
                                        x =>
                                        x.AlmacenId == caratula.AlmacenId)
                                    .Single();
                                string jsonCaratula = JsonConvert.SerializeObject(caratula);
                                <tr>
                                    <td>@(caratula.FechaRegistro?.ToString("yyyy/MM/dd"))</td>
                                    <td>@caratula.Almacen.Estado</td>
                                    <td>@caratula.Almacen.Ciudad</td>
                                    <td>@caratula.Almacen.Nombre</td>
                                    <td>@caratula.Folio</td>
                                    <td>@caratula.Estatus.Nombre</td>
                                    <td>@(caratula.Usuario?.Nombre ?? "Sin Capturar")</td>
                                    <td>
                                        @switch (@caratula.EstatusCaratulaVenta)
                                        {
                                            case 1:
                                                if (PermisoAlmacenCaratula.B_CaratulaVentaCrear)
                                                {
                                                    <a href="@Url.Action("Index", @TextoCaratulaVenta, caratula)"
                                                       class="btn btn-sm btn-success"
                                                       role="button"
                                                       aria-disabled="false">
                                                        <i class="bi bi-clipboard2-plus-fill"></i>
                                                        Capturar
                                                    </a>
                                                }
                                                break;
                                            case 2:
                                                if (PermisoAlmacenCaratula.B_CaratulaVentaActualizar)
                                                {
                                                    <a href="@Url.Action("Actualizar", @TextoCaratulaVenta, caratula)"
                                                       class="btn btn-sm btn-primary"
                                                       role="button"
                                                       aria-disabled="false">
                                                        <i class="bi bi-pen-fill"></i>
                                                        Actualizar
                                                    </a>
                                                }
                                                break;
                                            case 3:
                                                if (PermisoAlmacenCaratula.B_CaratulaVentaConsultar)
                                                {
                                                    <a href="@Url.Action("Consultar", @TextoCaratulaVenta, caratula)"
                                                       class="btn btn-sm btn-info"
                                                       role="button"
                                                       aria-disabled="false">
                                                        <i class="bi bi-search"></i>
                                                        Consultar
                                                    </a>
                                                }
                                                break;
                                            default:
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (@caratula.EstatusCaratulaVenta > 1)
                                        {
                                            switch (@caratula.EstatusCaratulaEfectivo)
                                            {
                                                case 1:
                                                    if (PermisoAlmacenCaratula.B_CaratulaEfectivoCrear)
                                                    {
                                                        <a href="@Url.Action("Index", @TextoCaratulaEfectivo, caratula)"
                                                           class="btn btn-sm btn-success"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-clipboard2-plus-fill"></i>
                                                            Capturar
                                                        </a>
                                                    }
                                                    break;
                                                case 2:
                                                    if (PermisoAlmacenCaratula.B_CaratulaEfectivoActualizar)
                                                    {
                                                        <a href="@Url.Action("Actualizar", @TextoCaratulaEfectivo, caratula)"
                                                           class="btn btn-sm btn-primary"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-pen-fill"></i>
                                                            Actualizar
                                                        </a>
                                                    }
                                                    break;
                                                case 3:
                                                    if (PermisoAlmacenCaratula.B_CaratulaEfectivoConsultar)
                                                    {
                                                        <a href="@Url.Action("Consultar", @TextoCaratulaEfectivo, caratula)"
                                                           class="btn btn-sm btn-info"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-search"></i>
                                                            Consultar
                                                        </a>
                                                    }
                                                    break;
                                                default:
                                                    break;
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (@caratula.EstatusCaratulaEfectivo > 1)
                                        {
                                            switch (@caratula.EstatusCaratulaVoucher)
                                            {
                                                case 1:
                                                    if (PermisoAlmacenCaratula.B_CaratulaVoucherCrear)
                                                    {
                                                        <a href="@Url.Action("Index", @TextoCaratulaVoucher, caratula)"
                                                           class="btn btn-sm btn-success"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-clipboard2-plus-fill"></i>
                                                            Capturar
                                                        </a>
                                                    }
                                                    break;
                                                case 2:
                                                    if (PermisoAlmacenCaratula.B_CaratulaVoucherActualizar)
                                                    {
                                                        <a href="@Url.Action("Actualizar", @TextoCaratulaVoucher, caratula)"
                                                           class="btn btn-sm btn-primary"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-pen-fill"></i>
                                                            Actualizar
                                                        </a>
                                                    }
                                                    break;
                                                case 3:
                                                    if (PermisoAlmacenCaratula.B_CaratulaVoucherConsultar)
                                                    {
                                                        <a href="@Url.Action("Consultar", @TextoCaratulaVoucher, caratula)"
                                                           class="btn btn-sm btn-info"
                                                           role="button"
                                                           aria-disabled="false">
                                                            <i class="bi bi-search"></i>
                                                            Consultar
                                                        </a>
                                                    }
                                                    break;
                                                default:
                                                    break;
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (PermisoAlmacenCaratula.B_CaratulaConsultar)
                                        {
                                            if (caratula.EstatusCaratulaVoucher > 1)
                                            {
                                                if (caratula.B_ConsultarCaratula)
                                                {
                                                    <a href="@Url.Action("Index", @TextoCaratulaReporte, caratula)"
                                                       class="btn btn-sm btn-primary"
                                                       role="button"
                                                       aria-disabled="false">
                                                        <i class="bi bi-clipboard-data"></i>
                                                        Caratula
                                                    </a>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#@(idTableAlmacenCaratula)').DataTable();
        });
    </script>
}
