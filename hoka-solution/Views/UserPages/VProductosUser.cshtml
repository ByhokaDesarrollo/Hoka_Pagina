@{
    ViewBag.Title = "REPORTE VENTA POR PRODUCTO";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioUser","UserPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>

        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>REPORTE DE VENTAS POR PRODUCTO</h1>
                        </div>
                    </div>
                </div>
                <hr />

                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        @using (Html.BeginForm("AdminPages", "filtrarTablaR", FormMethod.Post, new { id = "filtrarBusqueda" }))
                        {
                            <div class="row">
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaInicioR">Fecha inicio:</label>
                                    <input type="text" id="fechaInicio" name="fechaInicio" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaFinR">Fecha fin:</label>
                                    <input type="text" id="fechaFin" name="fechaFin" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="almacen">Almacen</label>
                                    <select class="form-control select2 almacen-select" style="width: 100%" id="almacen" name="almacen" data-url="@Url.Action("AdminPages", "ObtenerCategorias")">
                                        <option selected="selected">Selecciona un almacen</option>
                                        @foreach (var almacen in ViewBag.Almacenes)
                                        {
                                            <option value="@almacen.Item1">@($"{almacen.Item1} - {almacen.Item2}")</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                                    <label for="categoria">Categoria</label>
                                    <select class="form-control select2 categoria-select" style="width: 100%" id="categoria" name="categoria[]" disabled data-url="@Url.Action("AdminPages", "ObtenerGrupos")" multiple>
                                        <option selected="selected">Selecciona una categoria</option>
                                        <option value="all">Seleccionar todo</option>
                                    </select>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                                    <label for="grupo">Grupo</label>
                                    <select class="form-control select2 grupo-select" style="width: 100%" id="grupo" name="grupo[]" disabled multiple>
                                        <option selected="selected">Selecciona un grupo</option>
                                        <option value="all">Seleccionar todo</option>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-12 mt-2 mt-lg-0">
                                    <label for="btn-filtrar">Filtrar:</label>
                                    <div>
                                        <button type="submit" id="btn-filtrar" class="btn btn-info">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaRemisiod">
                                <thead>
                                    <tr>
                                        <th>CodigoBarra</th>
                                        <th>Producto</th>
                                        <th>Almacen</th>
                                        <th>Linea</th>
                                        <th>Grupo</th>
                                        <th>Uni. Vendidas Periodo</th>
                                        <th>Venta Real</th>
                                        <th>Venta S/IVA</th>
                                        <th>Venta Costo</th>
                                        <th>Costo</th>
                                        <th>Existencias</th>
                                        <th>Valor Inventario</th>
                                        <th>P.Pub</th>
                                        <th>Utilidad</th>
                                        <th>DEPOR</th>
                                        <th>Fijo</th>
                                        <th>Ult.Fecha</th>
                                        <th>DEPORT STRING</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!--Contenido de la petición por filtrado de busqueda-->
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th id="sumaCantidads">Cantidades:</th>
                                        <th id="sumaVreal">VentaReal:</th>
                                        <th id="sumaVSiva">VentaSinIVA:</th>
                                        <th id="sumaVcosto">VentaCosto:</th>
                                        <th id="sumaCosto">Costo(Ultcost)</th>
                                        <th></th>
                                        <th id="sumaVInventario">ValorInventario:</th>
                                        <th></th>
                                        <th id="sumaUtilidad">Utilidad:</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        @section scripts {
                            <script>
                                $(document).ready(function () {
                                    //Funciones para hacer interaccion con cada select
                                    var selectedAlmacen = null;
                                    var selectedCategorias = [];
                                    var selectedGrupos = [];

                                    $('.almacen-select').change(function () {
                                        selectedAlmacen = $(this).val();
                                        var categoriaSelect = $('.categoria-select');
                                        var grupoSelect = $('.grupo-select');

                                        if (!selectedAlmacen || selectedAlmacen === "Selecciona un almacen") {
                                            categoriaSelect.prop('disabled', true);
                                            grupoSelect.prop('disabled', true);
                                            selectedCategorias = [];
                                            categoriaSelect.val('Selecciona una categoria').change();
                                            grupoSelect.val('Selecciona un grupo').change();
                                        } else {
                                            categoriaSelect.prop('disabled', false);
                                            obtenerCategorias();
                                        }
                                    });

                                    // Al seleccionar una opción en categoría
                                    $('.categoria-select').on('select2:select', function (e) {
                                        var options = $(this).find('option').map(function () { return this.value; }).get();
                                        var index = options.indexOf('Selecciona una categoría');
                                        if (index > -1) {
                                            options.splice(index, 1);
                                        }

                                        var selectAllSelected = $(this).val().length === options.length;
                                        if (e.params.data.id === 'all' && !selectAllSelected) {
                                            $(this).val(options).trigger('change');
                                        }
                                        selectedCategorias = $(this).val();

                                        var grupoSelect = $('.grupo-select');
                                        if (selectedCategorias && selectedCategorias.length > 0 && selectedCategorias[0] !== 'Selecciona una categoría') {
                                            grupoSelect.prop('disabled', false);
                                            obtenerGrupos();
                                        } else {
                                            grupoSelect.prop('disabled', true);
                                            grupoSelect.val('Selecciona un grupo').trigger('change');
                                        }
                                    });

                                    // Al deseleccionar una opción en categoría
                                    $('.categoria-select').on('select2:unselect', function (e) {
                                        if (e.params.data.id === 'all') {
                                            $(this).val([]).trigger('change');
                                        }
                                        selectedCategorias = $(this).val();

                                        var grupoSelect = $('.grupo-select');
                                        if (selectedCategorias && selectedCategorias.length > 0 && selectedCategorias[0] !== 'Selecciona una categoría') {
                                            grupoSelect.prop('disabled', false);
                                            obtenerGrupos();
                                        } else {
                                            grupoSelect.prop('disabled', true);
                                            grupoSelect.val('Selecciona un grupo').trigger('change');
                                        }
                                    });

                                    // Al seleccionar una opción en grupo
                                    $('.grupo-select').on('select2:select', function (e) {
                                        var options = $(this).find('option').map(function () { return this.value; }).get();
                                        var index = options.indexOf('Selecciona un grupo');
                                        if (index > -1) {
                                            options.splice(index, 1);
                                        }

                                        var selectAllSelected = $(this).val().length === options.length;
                                        if (e.params.data.id === 'all' && !selectAllSelected) {
                                            $(this).val(options).trigger('change');
                                        }
                                        selectedGrupos = $(this).val();
                                    });

                                    // Al deseleccionar una opción en grupo
                                    $('.grupo-select').on('select2:unselect', function (e) {
                                        if (e.params.data.id === 'all') {
                                            $(this).val('Selecciona un grupo').trigger('change');
                                        }
                                        selectedGrupos = $(this).val();
                                    });

                                    function obtenerCategorias() {
                                        if (selectedAlmacen !== null) {
                                            var categoriaSelect = $('.categoria-select');
                                            categoriaSelect.prop('disabled', true).val('').change();

                                            $.ajax({
                                                url: '/AdminPages/ObtenerCategorias',
                                                type: 'GET',
                                                data: { ObAlmacen: selectedAlmacen },
                                                success: function (data) {
                                                    categoriaSelect.find('option').not(':first').remove();

                                                    if (Array.isArray(data)) {
                                                        categoriaSelect.append($('<option>', {
                                                            value: 'all',
                                                            text: 'Seleccionar todo'
                                                        }));
                                                        $.each(data, function (index, item) {
                                                            categoriaSelect.append($('<option>', {
                                                                value: item.categoria,
                                                                text: item.categoria
                                                            }));
                                                        });
                                                    } else {
                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Error',
                                                            text: 'Los datos no son una matriz válida.'
                                                        });
                                                    }

                                                    categoriaSelect.prop('disabled', false);
                                                },
                                                error: function () {
                                                    // Manejar el error de la solicitud AJAX si es necesario
                                                }
                                            });
                                        }
                                    }

                                    function obtenerGrupos() {
                                        if (selectedAlmacen !== null && selectedCategorias.length > 0) {
                                            var grupoSelect = $('.grupo-select');
                                            grupoSelect.prop('disabled', true).val('').change();

                                            $.ajax({
                                                url: '/AdminPages/ObtenerGrupos',
                                                type: 'GET',
                                                data: { ObAlmacen: selectedAlmacen, ObCategoria: JSON.stringify(selectedCategorias) },
                                                success: function (data) {
                                                    grupoSelect.find('option').not(':first').remove();
                                                    if (Array.isArray(data)) {
                                                        grupoSelect.append($('<option>', {
                                                            value: 'all',
                                                            text: 'Seleccionar todo'
                                                        }));
                                                        $.each(data, function (index, item) {
                                                            grupoSelect.append($('<option>', {
                                                                value: item.grupo,
                                                                text: item.grupo
                                                            }));
                                                        });
                                                    } else {
                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Error',
                                                            text: 'Los datos no son una matriz válida.'
                                                        });
                                                    }

                                                    grupoSelect.prop('disabled', false);
                                                },
                                                error: function () {
                                                    // Manejar el error de la solicitud AJAX si es necesario
                                                }
                                            });
                                        } else {
                                            var grupoSelect = $('.grupo-select');
                                            grupoSelect.prop('disabled', true).val('').change();
                                        }
                                    }

                                    //Aqui empieza la tabla
                                    var $filtrarBusqueda = $('#filtrarBusqueda');
                                    var $tablaRemisiod = $('#tablaRemisiod');

                                    // modificaciones de los selects fecha
                                    $("#fechaInicio, #fechaFin").datepicker({
                                        format: 'dd/mm/yyyy',
                                        language: 'es',
                                        autoclose: true,
                                        todayHighlight: true
                                    });

                                    $("#fechaInicio, #fechaFin").on("keyup", function () {
                                        var valor = $(this).val().replace(/\D/g, "").replace(/^(\d\d)(\d)/g, "$1/$2").replace(/\/(\d\d)(\d)/, "/$1/$2");
                                        $(this).val(valor.substring(0, 10));
                                    });

                                    $("#fechaInicio, #fechaFin").keypress(function (e) {
                                        var charCode = (e.which) ? e.which : e.keyCode;
                                        if ($(this).val().length >= 10 && (charCode >= 48 && charCode <= 57)) {
                                            return false;
                                        } else if (charCode >= 48 && charCode <= 57) {
                                            return true;
                                        }
                                        return false;
                                    });

                                    // Evitar que se pegue texto no deseado
                                    $("#fechaInicio, #fechaFin").on('paste', function (e) {
                                        e.preventDefault();
                                    });

                                    // Inicializar Select2 Elements
                                    $('.select2').select2();

                                    // Inicializar Select2 Elements
                                    $('.select2bs4').select2({
                                        theme: 'bootstrap4'
                                    });

                                    $tablaRemisiod.DataTable({
                                        language: {
                                            "sProcessing": "Procesando...",
                                            "sLengthMenu": "Mostrar _MENU_ registros",
                                            "sZeroRecords": "No se encontraron resultados",
                                            "sEmptyTable": "Ningun dato disponible en esta tabla",
                                            "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                                            "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                                            "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                                            "sInfoPostFix": "",
                                            "sSearch": "Buscar:",
                                            "sUrl": "",
                                            "sInfoThousands": ",",
                                            "sLoadingRecords": "Cargando...",
                                            "oPaginate": {
                                                "sFirst": "Primero",
                                                "sLast": "Último",
                                                "sNext": "Siguiente",
                                                "sPrevious": "Anterior"
                                            },
                                            "oAria": {
                                                "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                                                "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                                            }
                                        },

                                        "dom": 'Blfrtip',
                                        "lengthMenu": [[10, 50, 100, 1000, 2000, -1], [10, 50, 100, 1000, 2000, "Todos"]],
                                        "pageLength": -1,

                                        buttons: [
                                            {
                                                extend: 'excel',
                                                className: 'btn btn-excel rounded-0',
                                                text: '<i class="fas fa-file-excel"></i> Excel',
                                                filename: function () {
                                                    var now = new Date();
                                                    var day = ("0" + now.getDate()).slice(-2);
                                                    var month = ("0" + (now.getMonth() + 1)).slice(-2);
                                                    var year = now.getFullYear();
                                                    var dateString = day + '-' + month + '-' + year;
                                                    var hours = now.getHours();
                                                    var minutes = now.getMinutes();
                                                    var ampm = hours >= 12 ? 'PM' : 'AM';
                                                    hours = hours % 12;
                                                    hours = hours ? hours : 12;
                                                    minutes = minutes < 10 ? '0' + minutes : minutes;
                                                    var timeString = hours + '-' + minutes + ' ' + ampm;
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';
                                                    var fechaInicio = $('#fechaInicio').val().replace(/\//g, '-');
                                                    var fechaFin = $('#fechaFin').val().replace(/\//g, '-');
                                                    return 'HOKA_REPORTE VENTA POR PRODUCTO_SUCURSAL_' + nombreAlmacen + '_DEL_' + fechaInicio + '_AL_' + fechaFin + '_IMPRESO EL_' + dateString + '_CON HORA_' + timeString;
                                                },
                                                footer: {
                                                    columns: [3]
                                                }
                                            },
                                            {
                                                extend: 'pdf',
                                                className: 'btn btn-pdf rounded-0',
                                                text: '<i class="fas fa-file-pdf"></i> PDF',
                                                title: null,
                                                pageSize: 'A2',
                                                orientation: 'landscape',
                                                filename: function () {
                                                    var now = new Date();
                                                    var dateString = now.toISOString().slice(0, 10);
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';
                                                    return 'HOKA_REPORTE VENTA POR PRODUCTO_SUCURSAL_' + nombreAlmacen + '_' + dateString;
                                                },
                                                customize: function (doc) {
                                                    doc.defaultStyle.fontSize = 14;
                                                    var currentDateTime = new Date();
                                                    var currentDateTimeString = currentDateTime.toLocaleString();
                                                    var fechaInicio = document.getElementById('fechaInicio').value;
                                                    var fechaFin = document.getElementById('fechaFin').value;
                                                    var fechaRango = 'DEL ' + fechaInicio + ' AL ' + fechaFin;
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var sucursal = 'SUCURSAL ' + almacenSeleccionado + ' - ' + fechaRango;
                                                    var tituloReporte = 'HOKA - REPORTE VENTA POR PRODUCTO';
                                                    var reporteDelDia = 'REPORTE DEL DÍA ' + currentDateTimeString;

                                                    doc.content.splice(0, 0, {
                                                        text: tituloReporte,
                                                        alignment: 'center',
                                                        margin: [0, 0, 20, 20],
                                                        fontSize: 24,
                                                        bold: true
                                                    });

                                                    doc.content.splice(1, 0, {
                                                        columns: [
                                                            {
                                                                text: reporteDelDia,
                                                                alignment: 'left',
                                                                fontSize: 18
                                                            },
                                                            {
                                                                text: sucursal,
                                                                alignment: 'right',
                                                                fontSize: 18
                                                            }
                                                        ],
                                                        columnGap: 10
                                                    });
                                                },
                                                footer: {
                                                    columns: [3]
                                                },
                                            },
                                        ],

                                        columns: [
                                            { data: 'Group_codigobarras' },
                                            { data: 'Group_productoNombre' },
                                            { data: 'Group_almacen' },
                                            { data: 'Group_categoria' },
                                            { data: 'Group_grupo' },
                                            { data: 'Group_cantidads' },
                                            {
                                                data: 'Group_VentaReal',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_VentaSinIVA',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_vcosto',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'ultcost',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            { data: 'Group_Existencia' },
                                            {
                                                data: 'Group_VInventario',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_preciopub',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_utilidad',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_total_depor',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Group_total_fijo',
                                                render: function (data, type, row) {
                                                    return parseFloat(data).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                                }
                                            },
                                            {
                                                data: 'Gruop_fecha',
                                                render: function (data, type, row) {
                                                    return moment(data).utc().format('DD/MM/YYYY');
                                                }
                                            },
                                            {
                                                data: 'Depor_string',
                                            },
                                        ],

                                        deferRender: true,
                                        drawCallback: function (settings) {
                                        },
                                        footerCallback: function (row, data, start, end, display) {
                                            var api = this.api();

                                            function roundToTwoDecimals(number) {
                                                return +(Math.round(number + "e+2") + "e-2");
                                            }

                                            var totalCantidads = api.column(5, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalVentaReal = api.column(6, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalVentaSinIVA = api.column(7, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalVentaCosto = api.column(8, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalCosto = api.column(9, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalVInventario = api.column(11, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                                            var totalUtilidad = api.column(13, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);

                                            totalVentaReal = roundToTwoDecimals(totalVentaReal);
                                            totalVentaSinIVA = roundToTwoDecimals(totalVentaSinIVA);
                                            totalVentaCosto = roundToTwoDecimals(totalVentaCosto);
                                            totalCosto = roundToTwoDecimals(totalCosto);
                                            totalVInventario = roundToTwoDecimals(totalVInventario);
                                            totalUtilidad = roundToTwoDecimals(totalUtilidad);

                                            $('#sumaCantidads').html('Total Cantidad: ' + totalCantidads);
                                            $('#sumaVreal').html('Total Venta Real: $' + totalVentaReal.toLocaleString('es-MX'));
                                            $('#sumaVSiva').html('Total Venta S/IVA: $' + totalVentaSinIVA.toLocaleString('es-MX'));
                                            $('#sumaVcosto').html('Total Venta Costo: $' + totalVentaCosto.toLocaleString('es-MX'));
                                            $('#sumaCosto').html('Total Costo: $' + totalCosto.toLocaleString('es-MX'));
                                            $('#sumaVInventario').html('Total Valor Inventario: $' + totalVInventario.toLocaleString('es-MX'));
                                            $('#sumaUtilidad').html('Total Utilidad: $' + totalUtilidad.toLocaleString('es-MX'));
                                        },
                                    });

                                    // Reemplaza la función $filtrarBusqueda.on('submit', ...) con este código:

                                    $filtrarBusqueda.on('submit', function (event) {
                                        event.preventDefault();

                                        // Limpiar la tabla antes de nueva búsqueda
                                        var table = $tablaRemisiod.DataTable();
                                        table.clear().draw();

                                        var fechaInicio = $('#fechaInicio').val();
                                        var fechaFin = $('#fechaFin').val();
                                        var almacen = $('#almacen').val();
                                        var categoria = $('#categoria').val() || [];
                                        var grupo = $('#grupo').val() || [];

                                        // Validación básica
                                        if (!fechaInicio || !fechaFin || !almacen) {
                                            Swal.fire('Error', 'Fechas y almacén son requeridos', 'error');
                                            return;
                                        }

                                        // Variables para la paginación
                                        var currentPage = 1;
                                        var pageSize = 5000; // Puedes ajustar este valor según necesidad
                                        var isLoading = false;
                                        var hasMoreData = true;
                                        var totalLoaded = 0;

                                        // Mostrar loading con progreso
                                        var progressSwal = Swal.fire({
                                            title: 'Procesando',
                                            html: 'Buscando registros...<br><div id="progress" style="margin-top:10px">0 registros cargados</div>',
                                            allowOutsideClick: false,
                                            didOpen: () => {
                                                Swal.showLoading();
                                            }
                                        });

                                        // Función para cargar la siguiente página
                                        function loadNextPage() {
                                            if (isLoading || !hasMoreData) return;

                                            isLoading = true;

                                            $.ajax({
                                                url: '@Url.Action("getReportSalesByProduct", "AdminPages")',
                                                type: 'POST',
                                                contentType: 'application/json',
                                                dataType: 'json',
                                                data: JSON.stringify({
                                                    fechaInicio: fechaInicio,
                                                    fechaFin: fechaFin,
                                                    almacen: almacen,
                                                    categoria: categoria,
                                                    grupo: grupo,
                                                    page: currentPage,
                                                    pageSize: pageSize
                                                }),
                                                success: function (response) {
                                                    if (!response.success) {
                                                        Swal.fire('Error', response.message || 'Error desconocido', 'error');
                                                        return;
                                                    }

                                                    // Procesar los datos recibidos
                                                    if (response.data && response.data.length > 0) {
                                                        table.rows.add(response.data).draw(false);
                                                        totalLoaded += response.data.length;

                                                        // Actualizar el contador en el modal
                                                        $('#progress').html(totalLoaded + ' registros cargados');
                                                    }

                                                    // Verificar si hay más datos
                                                    hasMoreData = response.hasMore;
                                                    currentPage++;

                                                    // Si hay más datos, cargar la siguiente página
                                                    if (hasMoreData) {
                                                        setTimeout(loadNextPage, 100); // Pequeño delay para no saturar
                                                    } else {
                                                        // Cuando se terminan los datos, redibujar la tabla completa
                                                        table.draw();
                                                        progressSwal.close();
                                                        Swal.fire('Completado', `Se cargaron ${totalLoaded} registros`, 'success');
                                                    }

                                                    isLoading = false;
                                                },
                                                error: function (xhr, status, error) {
                                                    progressSwal.close();
                                                    isLoading = false;

                                                    var errorMsg = `Status: ${xhr.status} - ${error}`;
                                                    if (xhr.status === 500 && xhr.responseText.includes('maxJsonLength')) {
                                                        errorMsg = "Los datos son demasiado grandes. Intenta con un rango de fechas más pequeño.";
                                                    }

                                                    Swal.fire({
                                                        title: 'Error en la solicitud',
                                                        text: errorMsg,
                                                        icon: 'error'
                                                    });
                                                }
                                            });
                                        }

                                        // Iniciar la carga de la primera página
                                        loadNextPage();
                                    });

                                    // Agregar scroll infinito
                                    $('.dataTables_scrollBody').scroll(function() {
                                        var scrollTop = $(this).scrollTop();
                                        var scrollHeight = $(this).prop('scrollHeight');
                                        var clientHeight = $(this).height();

                                        // Si estamos cerca del final (100px), cargar más datos
                                        if (scrollTop + clientHeight >= scrollHeight - 100) {
                                            $filtrarBusqueda.trigger('scroll-to-bottom');
                                        }
                                    });

                                    // Escuchar evento personalizado para cargar más datos
                                    $filtrarBusqueda.on('scroll-to-bottom', function() {
                                        // La función loadNextPage ya está definida en el submit
                                        // Solo necesitamos asegurarnos de que se pueda llamar
                                        if (typeof loadNextPage === 'function') {
                                            loadNextPage();
                                        }
                                    });

                                    // Función para procesar datos en lotes
                                    function processDataInBatches(data, batchSize) {
                                        var table = $tablaRemisiod.DataTable();
                                        var total = data.length;
                                        var processed = 0;

                                        function processBatch(start) {
                                            var end = Math.min(start + batchSize, total);
                                            var batch = data.slice(start, end);

                                            requestAnimationFrame(function() {
                                                table.rows.add(batch).draw(false);
                                                processed += batch.length;

                                                if (end < total) {
                                                    processBatch(end);
                                                } else {
                                                    table.draw();
                                                    Swal.fire('Completado', `Se cargaron ${total} registros`, 'success');
                                                }
                                            });
                                        }

                                        processBatch(0);
                                    }

                                    $tablaRemisiod.on('length.dt', function (e, settings, len) {
                                        // Si requieres alguna acción al cambiar la cantidad de registros, ponla aquí
                                    });
                                });
                            </script>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</body>
</html>