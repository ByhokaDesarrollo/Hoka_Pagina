
@{
    ViewBag.Title = "REPORTE";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioAdmin", "AdminPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion", "Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>REPORTE REGISTRO DE VENTAS</h1>
                        </div>
                    </div>
                </div>
                <hr />
                <!--Inicio de contenido-->
                <div class="card">
                    
                   

                    <div class="card-header">
                        <div class="row">
                            <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                <label for="fecha">Fecha </label>
                                <input type="hidden" id="idAlmacen" value="@ViewBag.IdAlmacen" />
                                <input type="text" id="fecha" name="fecha" class="form-control select2" placeholder="dd/mm/aaaa" autocomplete="off" value="@ViewBag.Fecha" >
                            </div>
                            <input type="hidden" name="IdRegistroVentas" value="@ViewBag.RegistroVentaCategoriasId" />
                              
                            <div class="col-lg-1 mt-2 mt-lg-0">
                                <label for="btn-filter">Filtrar</label>
                                <div>
                                    <button type="submit" id="btn-filter" class="btn btn-info">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                </div>
                            </div>
                            @*@if (@ViewBag.RegistroVentaCategoriasEstado == 0)
                            {*@
                                <div class="col-2">
                                    <label>Modificar Estado</label><br />
                                    <button type="button" class="btn btn-info next" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                        Abrir
                                    </button>
                                </div>
                            @*}*@



                        </div>
                    </div>
                    <div class="card-body">
                        <div class="card-body">
                            <div class="table table-responsive">
                                <table class="table table-striped" id="tableContainer">
                                    <thead>
                                        <tr>
                                            <th>Categoria</th>
                                            <th>Venta Sistema</th>
                                            <th>Venta Tienda</th>
                                            <th>Comisiones Clave</th>
                                            <th>Neto Venta</th>
                                            <th>Fecha</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th></th>
                                            <th id="totalVenta"></th>
                                            <th>Venta Tienda</th>
                                            <th id="totalComisiones"></th>
                                            <th id="totalNetoVenta"></th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>


</body>
</html>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form2">
                    <div class="form-group">
                        <div class="form-group">
                            <label>Estado</label>
                            <select class="form-control" name="Estado">
                                <option value="0">Borrador</option>
                                <option value="1">Publicado</option>
                            </select>
                        </div>
                        <p>
                            Publicado: no podrá hacer modificaciones.<br />
                            Borrador: podrá hacer modificaciones.
                        </p>
                        <label>Ingresar el código en pantalla para actualizar la información.</label>
                        <p>Código: <span id="code"></span></p>
                        <input name="code" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary send" data-code="yes" >Actualizar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalx2" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="form2">

                    <div class="form-group">
                        <div class="form-group">
                            <label>Venta Tienda</label>
                            <input type="number" name="VentaTienda" value="" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="form-group">
                            <label>Comisiones</label>
                            <input type="number" name="Comisiones" value="" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary send" data-code="no" >Actualizar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section scripts {

    <script>

    $(document).ready(function () {

        var $btnFilter = $('#btn-filter');
        var $table = $('#tableContainer');

        $("#fecha").datepicker({
            format: 'dd/mm/yyyy',
            language: 'es',
            autoclose: true,
            todayHighlight: true
        });

        $("#fecha").on("keyup", function () {
            var valor = $(this).val().replace(/\D/g, "").replace(/^(\d\d)(\d)/g, "$1/$2").replace(/\/(\d\d)(\d)/, "/$1/$2");
            $(this).val(valor.substring(0, 10));  // Limitar a 10 caracteres
        });

        $("#fecha").keypress(function (e) {
            // Permitir solo números y limitar a 10 caracteres (incluyendo '/')
            var charCode = (e.which) ? e.which : e.keyCode;
            if ($(this).val().length >= 10 && (charCode >= 48 && charCode <= 57)) {
                return false;
            } else if (charCode >= 48 && charCode <= 57) {
                return true;
            }
            return false;
        });

        // Evitar que se pegue texto no deseado
        $("#fecha").on('paste', function (e) {
            e.preventDefault();
        });



        $table.DataTable({
            searching: false, paging: false,info: false,
            processing: true,
            responsive: true,
            "autoWidth": false,
            language: {
                "processing": '<i class="fa fa-spinner fa-spin fa-3x fa-fw"></i><span class="sr-only">Loading...</span> ',
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "Ningún dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sInfoPostFix": "",
                "sSearch": "Buscar:",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Cargando...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                },
                "oAria": {
                    "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                    "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                }
            },

            "dom": 'Blfrtip',
            "lengthMenu": [[10, 50, 100, 1000, 2000, -1], [10, 50, 100, 1000, 2000, "Todos"]],
            "pageLength": -1,
            scrollX: true,
            buttons: [
                {
                    extend: 'excel',
                    className: 'btn btn-excel rounded-0',
                    text: '<i class="fas fa-file-excel"></i> Excel',
                    filename: function () {
                        // Obtiene la fecha y hora actual.
                        var now = new Date();

                        // Formatea la fecha actual en dd-mm-yyyy.
                        var day = ("0" + now.getDate()).slice(-2);
                        var month = ("0" + (now.getMonth() + 1)).slice(-2);
                        var year = now.getFullYear();
                        var dateString = day + '-' + month + '-' + year;

                        // Convierte la hora a formato de 12 horas con AM o PM.
                        var hours = now.getHours();
                        var minutes = now.getMinutes();
                        var ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12;
                        hours = hours ? hours : 12; // La hora '0' debería ser '12'.
                        minutes = minutes < 10 ? '0' + minutes : minutes;
                        var timeString = hours + ':' + minutes + ' ' + ampm;

                        // Obtiene la información del almacén seleccionado.
                        //var almacenSeleccionado = $('#almacen option:selected').text();
                        //var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';

                        // Obtiene las fechas de inicio y fin seleccionadas y las formatea.
                        //var fechaInicio = $('#fechaInicio').val().replace(/\//g, '-');
                        //var fechaFin = $('#fechaFin').val().replace(/\//g, '-');

                        // Formato del nombre del archivo: 'HOKA_REPORTE VENTA POR DEPARTAMENTO_NombreDelAlmacen_FechaInicio_FechaFin_FechaActual_HoraActual AM/PM.xlsx'
                        return 'HOKA REPORTE ' + dateString + ' ' + timeString;
                    },
                    footer: {
                        columns: [3]
                    },
                    exportOptions: {
                        columns: [0, 1, 2, 3,4,5]
                    }
                },
                {
                    extend: 'pdf',
                    className: 'btn btn-pdf rounded-0',
                    text: '<i class="fas fa-file-pdf"></i> PDF',
                    title: null,
                    pageSize: 'A2',  // Establece el tamaño de página a A3
                    orientation: 'landscape',
                    filename: function () {
                        // Obtiene la fecha actual en formato string.
                        var now = new Date();
                        var dateString = now.toISOString().slice(0, 10);

                        // Convierte la hora a formato de 12 horas con AM o PM.
                        var hours = now.getHours();
                        var minutes = now.getMinutes();
                        var ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12;
                        hours = hours ? hours : 12; // La hora '0' debería ser '12'.
                        minutes = minutes < 10 ? '0' + minutes : minutes;
                        var timeString = hours + ':' + minutes + ' ' + ampm;


                        // Obtiene la información del almacén seleccionado.
                        //var almacenSeleccionado = $('#almacen option:selected').text();
                        //var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';

                        // Formato del nombre del archivo: 'HOKA - REPORTE VENTA POR PRODUCTO_NombreDelAlmacen_Fecha.pdf'
                        return 'HOKA REPORTE - ' + dateString + ' ' + timeString;
                    },
                    customize: function (doc) {
                        doc.defaultStyle.fontSize = 14; //tamaño de las letras dentro de la tablas al exportar

                        // Obtiene la fecha y hora actuales.
                        var currentDateTime = new Date();
                        var currentDateTimeString = currentDateTime.toLocaleString();

                        // Obtiene el rango de fechas ingresado.
                        //var fechaInicio = document.getElementById('fechaInicio').value;
                        //var fechaFin = document.getElementById('fechaFin').value;
                        //var fechaRango = 'DEL ' + fechaInicio + ' AL ' + fechaFin;

                        // Obtiene la información del almacén seleccionado.
                        //var almacenSeleccionado = $('#almacen option:selected').text();
                        //var sucursal = 'SUCURSAL ' + almacenSeleccionado + ' - ' + fechaRango;

                        // Fija el título del reporte a "HOKA - VENTA POR PRODUCTO".
                        var tituloReporte = 'HOKA - REPORTE';
                        var reporteDelDia = 'REPORTE DEL DÍA ' + currentDateTimeString;

                        // Agrega el título en la parte superior del documento con texto en negrita.
                        doc.content.splice(0, 0, {
                            text: tituloReporte,
                            alignment: 'center',
                            margin: [0, 0, 20, 20],
                            fontSize: 24,
                            bold: true  // Texto en negrita
                        });

                        // Agrega la fecha del reporte y la información del almacén en la misma línea, alineados a la izquierda y a la derecha, respectivamente.
                        doc.content.splice(1, 0, {
                            columns: [
                                {
                                    text: reporteDelDia,
                                    alignment: 'left',
                                    fontSize: 18
                                },
                            ],
                            columnGap: 10  // Ajusta el espacio entre las columnas.
                        });
                    },
                    footer: {
                        columns: [11]
                    },
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5]
                    }
                }
            ],
            columns: [
                { data: 'Categoria' },
                { data: 'Venta' },
                { data: 'VentaTienda' },
                { data: 'Comisiones' },
                { data: 'NetoVenta' },
                { data: 'Fecha' },
                {
                    data: 'Acciones',
                    render: function (data, type, row) {

                        if(@ViewBag.RegistroVentaCategoriasEstado==0)
                        return "<a class='btn btn-info edition' data-id=" + row.Id + " data-ventasistema=" + row.Venta + " data-idregistroventas=" + row.IdRegistroVentas + " data-comisiones=" + row.Comisiones+ " data-ventatienda=" + row.VentaTienda + " data-bs-toggle='modal' data-bs-target='#modalx2'>Editar</button>";
                        else
                        return "";


                    }
                }


            ],

            deferRender: true, // Se habilita el renderizado diferido

            drawCallback: function (settings) {

            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api();

                var intval = function (i) {
                    //Excuse this ugliness, it comes from the datatables sample
                    return typeof i === 'string' ?
                        i.replace(/[\$,]/g, '') * 1 :
                        typeof i === 'number' ?
                            i : 0;
                };

                function roundToTwoDecimals(number) {
                    return +(Math.round(number + "e+2") + "e-2");
                }

                //var stotalColumnIndex = $('th').filter(function (i) { return $(this).text() == 'Stotal'; }).first().index();
                //var stotalData = api.column(stotalColumnIndex).data();
                //var stotal = stotalData.reduce(function (a, b) { return intval(a) + intval(b); }, 0).toFixed(2);


                //var stotal = api.column(3, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                var totalx = api.column(1, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                var ventaTienda = api.column(2, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                var calendarios = api.column(3, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);
                var ventas = api.column(4, { page: 'current' }).data().reduce(function (a, b) { return a + (parseFloat(b) || 0); }, 0);


                //totalx = roundToTwoDecimals(totalx);
                totalx = totalx.toLocaleString('es-MX')
                calendarios = calendarios.toLocaleString('es-MX')
                ventas = ventas.toLocaleString('es-MX')
                ventaTienda = ventaTienda.toLocaleString('es-MX')

                //stotal = roundToTwoDecimals(stotal);
                //$('#sumaTotal').html('Totalx: $' + totalx);

                //$('#stotalSum').html('sTotal: $' + stotalx.toLocaleString('es-MX'));
                console.log(totalx)

                $(api.column(1).footer()).html('totalVenta: $' + totalx);
                $(api.column(2).footer()).html('VentaTienda: $' + ventaTienda);
                $(api.column(3).footer()).html('totalComisiones: $' + calendarios);
                $(api.column(4).footer()).html('totalNetoVenta: $' + ventas);


                //$("#totalVenta").html("$"+totalVenta.toFixed(2))
                //$("#totalComisiones").html("$"+totalComisiones.toFixed(2))
                //$("#totalNetoVenta").html("$"+totalNetoVenta.toFixed(2))


            }
        });


        $btnFilter.on('click', function (event) {
            event.preventDefault();

            var fecha = $('#fecha').val();
            var idAlmacen = $('#idAlmacen').val();

            // Validar campos
            var formData = {
                fecha: fecha,
                idAlmacen: idAlmacen,
            };

            $.ajax({
                url: '/usuario/filter-getsalesbycategories',
                type: 'POST',
                data: formData,
                success: function (data) {
                    console.log(data)

                    var content = ""
                    var totalVenta = 0
                    var totalComisiones = 0
                    var totalNetoVenta = 0

                    $.each(data, function (index, value) {
                        var row = ""

                        content+= "<tr><td>" + value.Categoria + "</td><td>" + value.Venta + "</td><td>" + value.Comisiones + "</td><td>" + value.NetoVenta + "</td><td>" + value.Fecha + "</td></tr>"





                        totalVenta = totalVenta + value.Venta
                        totalComisiones = totalComisiones + value.Comisiones
                        totalNetoVenta = totalNetoVenta + value.NetoVenta
                    })



                    //$("#tableContainer tbody").html(html);

                    $table.DataTable().clear().rows.add(data).draw();


                    //$("#totalVenta").html("$"+totalVenta.toFixed(2))
                    //$("#totalComisiones").html("$"+totalComisiones.toFixed(2))
                    //$("#totalNetoVenta").html("$"+totalNetoVenta.toFixed(2))


                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('Error al filtrar/verificar filtrobusqueda');
                }
            });
        });


    })

        //
        var Id = 0;
        var VentaSistema = 0;

        $(document).on("click",".edition", function () {
            Id = $(this).attr("data-id")
            VentaSistema = $(this).attr("data-ventasistema")
            console.log(VentaSistema)

            $("input[name=Comisiones]").val($(this).attr("data-comisiones"))
            $("input[name=VentaTienda]").val($(this).attr("data-ventatienda"))

        })

        $(".next").on("click", function () {
            $("#code").html(generateCode())
        })

        $(".btn-update2").on("click", function () {
            $('#form2').submit()
        })

        function generateCode(length = 6) {
            let result = '';
            const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            const charactersLength = characters.length;
            let counter = 0;
            while (counter < length) {
                result += characters.charAt(Math.floor(Math.random() * charactersLength));
                counter += 1;
            }
            return result;
        }

        //
        IdRegistroVentas =0
        $(".send").on('click', function (event) {

            isValid = true;
            var url = "";

            code = $(this).attr("data-code")

            if (code == "yes") {
                if ($("input[name=code]").val() == $("#code").html()) {
                    isValid = true;
                    url = "/update-status-sales"
                    //IdRegistroVentas = $(".edition").attr("data-idregistroventas")
                    IdRegistroVentas = $("input[name=IdRegistroVentas]").val()
                }
                else {
                    isValid = false;
                }
            }
            else {
                isValid = true;
                url = "/update-data-sales"
            }

            console.log(isValid)

            //return null

            var Estado = $('select[name=Estado]').val()
            var Comisiones = $('input[name=Comisiones]').val()
            var VentaTienda = $('input[name=VentaTienda]').val()

            // Validar campos
            var formData = {
                Estado: Estado,
                Comisiones: Comisiones,
                VentaSistema: VentaSistema,
                VentaTienda: VentaTienda,
                Id: Id,
                IdRegistroVentas: IdRegistroVentas
            };

            console.log(formData)

            if (isValid) {
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function (data) {
                        location.reload()
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        alert('Error al filtrar/verificar filtrobusqueda');
                    }
                });
            }
        });




    </script>

}