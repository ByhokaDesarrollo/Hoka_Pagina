@{
    ViewBag.Title = "REPORTE";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}



<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
    <style>
        .readonly {
            background: #dee2e6;
            border: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioUser","UserPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>REPORTE EFECTIVO</h1>
                        </div>
                    </div>
                </div>
                <hr />



                
                    
                    <div class="card">
                        <!--Inicio de Botones del sidebar de la tabla de contenido-->
                        <div class="card-header">
                            <div class="row">
                                <div class="col-12">
                                    <b>Monedas</b>
                                </div>
                            </div>
                        </div>

                        <!--Cuerpo del contenido(en este caso la tabla)-->

                        <div class="card-body">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Moneda</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var moneda in ViewBag.Monedas)
                                        {
                                            <tr>
                                                <td>
                                                    @moneda.Nombre
                                                </td>
                                                <td>  
                                                    <a href="@Url.RouteUrl("usuario-reporte-registro-efectivo-monedas-valores", new { IdMoneda = moneda.Id })">Denominaciones</a> 
                                                </td>
                                            </tr>
                                        }

                                        </tbody>
                                </table>
                        </div>
                    </div>
              

            </section>
        </div>
    </div>
</body>
</html>
@section scripts {
    <script>
        
    </script>

    }

