
@{
    ViewBag.Title = "Venta por departamento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioAdmin","AdminPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>

        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>REPORTE DE VENTAS POR DEPARTAMENTO</h1>
                        </div>
                    </div>
                </div>
                <hr />

                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        @using (Html.BeginForm("AdminPages", "filtrarTablaA", FormMethod.Post, new { id = "filtrarBusqueda" }))
                        {
                            <div class="row">
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaInicioR">Fecha inicio:</label>
                                    <input type="text" id="fechaInicio" name="fechaInicio" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaFinR">Fecha fin:</label>
                                    <input type="text" id="fechaFin" name="fechaFin" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <label for="almacen">Almacen</label>
                                    <select class="form-control select2 almacen-select" style="width: 100%" id="almacen" name="almacen">
                                        <option selected="selected">Selecciona un almacen</option>
                                        @foreach (var almacen in ViewBag.Almacenes)
                                        {
                                            <option value="@almacen.Item1">@($"{almacen.Item1} - {almacen.Item2}")</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-12 mt-2 mt-lg-0">
                                    <label for="btn-filtrar">Filtrar:</label>
                                    <div>
                                        <button type="submit" id="btn-filtrar" class="btn btn-info">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaVAlmacen">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Souvenir</th>
                                        <th>Artesanias</th>
                                        <th>Artesanias Prem.</th>
                                        <th>Textil</th>
                                        <th>Farmacia</th>
                                        <th>Abarrotes</th>
                                        <th>Aguas</th>
                                        <th>Refrescos</th>
                                        <th>Tabaqueria</th>
                                        <th>Calendario Maya</th>
                                        <th>Energeticos</th>
                                        <th>S/Categoria</th>
                                        <th>Importe Total</th>
                                        <th>Total Ticket Cobrado</th>
                                        <th>Ticket Promedio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!--Aqui ira el contenido de la peticion por filtrado de busqueda -->
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>

                                        <th id="sumaSouvenir">Total Souvenir:</th>
                                        <th id="sumaArtesania">Total Artesanias:</th>
                                        <th id="sumaArtesaniaPrem">Total Art. Prem:</th>
                                        <th id="sumaTextil">Total Textil:</th>
                                        <th id="sumaFarmacia">Total Farmacia:</th>
                                        <th id="sumaAbarrotes">Total Abarrotes:</th>
                                        <th id="sumaRefrescos">Total Refrescos:</th>
                                        <th id="sumaAguas">Total Aguas:</th>
                                        <th id="sumaTabaqueria">Total Tabaqueria:</th>
                                        <th id="sumaCalendarios">Total Calendarios:</th>
                                        <th id="sumaEnergeticos">Total Energeticos:</th>
                                        <th id="sumaSinCategoria">Total S/Cat:</th>
                                        <th id="sumaTotal">Total General:</th>
                                        <th id="sumaTicketCobrado">Total Ticket Cobrado:</th>
                                        <th id="sumaTicketPromedio">Ticket Promedio:</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        @section scripts {
                            <script>
                                // Variable global para almacenar el total de registros
                                var totalRegistrosBD = 0;

                                $(document).ready(function () {
                                    // Configuración inicial
                                    var $filtrarBusqueda = $('#filtrarBusqueda');
                                    var $tablaVAlmacen = $('#tablaVAlmacen');

                                    // Configuración de datepicker para fechas
                                    $("#fechaInicio, #fechaFin").datepicker({
                                        format: 'dd/mm/yyyy',
                                        language: 'es',
                                        autoclose: true,
                                        todayHighlight: true
                                    });

                                    // Formateo de fechas mientras se escribe
                                    $("#fechaInicio, #fechaFin").on("keyup", function () {
                                        var valor = $(this).val().replace(/\D/g, "").replace(/^(\d\d)(\d)/g, "$1/$2").replace(/\/(\d\d)(\d)/, "/$1/$2");
                                        $(this).val(valor.substring(0, 10));
                                    });

                                    // Validación de entrada para fechas
                                    $("#fechaInicio, #fechaFin").keypress(function (e) {
                                        var charCode = (e.which) ? e.which : e.keyCode;
                                        if ($(this).val().length >= 10 && (charCode >= 48 && charCode <= 57)) {
                                            return false;
                                        } else if (charCode >= 48 && charCode <= 57) {
                                            return true;
                                        }
                                        return false;
                                    });

                                    // Prevenir pegado no deseado
                                    $("#fechaInicio, #fechaFin").on('paste', function (e) {
                                        e.preventDefault();
                                    });

                                    // Inicializar Select2
                                    $('.select2').select2();
                                    $('.select2bs4').select2({ theme: 'bootstrap4' });

                                    // Función para formatear números como moneda
                                    function formatCurrency(value) {
                                        if (isNaN(value) || value === null) {
                                            return '$0.00';
                                        }
                                        return '$' + parseFloat(value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                                    }

                                    // Función para formatear números normales con 2 decimales
                                    function formatNumber(value) {
                                        if (isNaN(value) || value === null) {
                                            return '0.00';
                                        }
                                        return parseFloat(value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                                    }

                                    // Inicialización de DataTable
                                    var table = $tablaVAlmacen.DataTable({
                                        language: {
                                            "sProcessing": "Procesando...",
                                            "sLengthMenu": "Mostrar _MENU_ registros",
                                            "sZeroRecords": "No se encontraron resultados",
                                            "sEmptyTable": "Ningun dato disponible en esta tabla",
                                            "sInfo": "Mostrando registros del _START_ al _END_",
                                            "sInfoEmpty": "Mostrando registros del 0 al 0",
                                            "sInfoFiltered": "",
                                            "sInfoPostFix": "",
                                            "sSearch": "Buscar:",
                                            "sUrl": "",
                                            "sInfoThousands": " ",
                                            "sLoadingRecords": "Cargando...",
                                            "oPaginate": {
                                                "sFirst": "Primero",
                                                "sLast": "Último",
                                                "sNext": "Siguiente",
                                                "sPrevious": "Anterior"
                                            },
                                            "oAria": {
                                                "sSortAscending": ": Activar para ordenar la columna de manera ascendente",
                                                "sSortDescending": ": Activar para ordenar la columna de manera descendente"
                                            }
                                        },
                                        "dom": 'Blfrtip',
                                        "lengthMenu": [[10, 50, 100, 1000, 2000, -1], [10, 50, 100, 1000, 2000, "Todos"]],
                                        "pageLength": -1,
                                        buttons: [
                                            {
                                                extend: 'excel',
                                                className: 'btn btn-excel rounded-0',
                                                text: '<i class="fas fa-file-excel"></i> Excel',
                                                filename: function () {
                                                    var now = new Date();
                                                    var day = ("0" + now.getDate()).slice(-2);
                                                    var month = ("0" + (now.getMonth() + 1)).slice(-2);
                                                    var year = now.getFullYear();
                                                    var dateString = day + '-' + month + '-' + year;
                                                    var hours = now.getHours();
                                                    var minutes = now.getMinutes();
                                                    var ampm = hours >= 12 ? 'PM' : 'AM';
                                                    hours = hours % 12;
                                                    hours = hours ? hours : 12;
                                                    minutes = minutes < 10 ? '0' + minutes : minutes;
                                                    var timeString = hours + '-' + minutes + ' ' + ampm;
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';
                                                    var fechaInicio = $('#fechaInicio').val().replace(/\//g, '-');
                                                    var fechaFin = $('#fechaFin').val().replace(/\//g, '-');
                                                    return 'HOKA_REPORTE VENTA POR DEPARTAMENTO_' + nombreAlmacen + '_DEL_' + fechaInicio + '_AL_' + fechaFin + '_IMPRESO EL_' + dateString + '_CON HORA_' + timeString;
                                                },
                                                footer: true
                                            },
                                            {
                                                extend: 'pdf',
                                                className: 'btn btn-pdf rounded-0',
                                                text: '<i class="fas fa-file-pdf"></i> PDF',
                                                title: null,
                                                pageSize: 'A2',
                                                orientation: 'landscape',
                                                filename: function () {
                                                    var now = new Date();
                                                    var dateString = now.toISOString().slice(0, 10);
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var nombreAlmacen = almacenSeleccionado.includes('-') ? almacenSeleccionado : 'SinNombre';
                                                    return 'HOKA_REPORTE VENTA POR DEPARTAMENTO_SUCURSAL_' + nombreAlmacen + '_' + dateString;
                                                },
                                                customize: function (doc) {
                                                    doc.defaultStyle.fontSize = 12;
                                                    var currentDateTime = new Date();
                                                    var currentDateTimeString = currentDateTime.toLocaleString();
                                                    var fechaInicio = document.getElementById('fechaInicio').value;
                                                    var fechaFin = document.getElementById('fechaFin').value;
                                                    var fechaRango = 'DEL ' + fechaInicio + ' AL ' + fechaFin;
                                                    var almacenSeleccionado = $('#almacen option:selected').text();
                                                    var sucursal = 'SUCURSAL ' + almacenSeleccionado + ' - ' + fechaRango;
                                                    var tituloReporte = 'HOKA - REPORTE VENTA POR DEPARTAMENTO';
                                                    var reporteDelDia = 'REPORTE DEL DÍA ' + currentDateTimeString;

                                                    doc.content.splice(0, 0, {
                                                        text: tituloReporte,
                                                        alignment: 'center',
                                                        margin: [0, 0, 20, 20],
                                                        fontSize: 20,
                                                        bold: true
                                                    });

                                                    doc.content.splice(1, 0, {
                                                        columns: [
                                                            { text: reporteDelDia, alignment: 'left', fontSize: 14 },
                                                            { text: sucursal, alignment: 'right', fontSize: 14 }
                                                        ],
                                                        columnGap: 10
                                                    });
                                                },
                                                footer: true
                                            },
                                        ],
                                        columns: [
                                            { data: 'Gruop_fecha', render: function (data) { return moment(data).utc().format('DD/MM/YYYY'); } },

                                            { data: 'Group_Souvenir', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Artesanias', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Artesanias_Premium', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Textil', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Farmacia', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Abarrotes', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Refrescos', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Aguas', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Tabaqueria', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Calendarios', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_Energeticos', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_SinCategoria', render: function (data) { return formatCurrency(data); } },
                                            { data: 'Group_TotalImporte', render: function (data) { return formatCurrency(data); } },
                                            {
                                                data: 'Group_TotalTickets',
                                                render: function (data) { return data || 0; }
                                            },
                                            {
                                                data: null,
                                                render: function (data, type, row) {
                                                    var totalImporte = parseFloat(data.Group_TotalImporte) || 0;
                                                    var ticketPromedio = totalImporte / (data.Group_TotalTickets > 0 ? data.Group_TotalTickets : 1);
                                                    return formatNumber(ticketPromedio);
                                                }
                                            }
                                        ],
                                        deferRender: true,
                                        footerCallback: function (row, data, start, end, display) {
                                            var api = this.api();

                                            function sumColumn(index) {
                                                return api.column(index, { page: 'current' }).data().reduce(function (a, b) {
                                                    var value = parseFloat(b) || 0;
                                                    return a + value;
                                                }, 0);
                                            }


                                            var TotalSouvenir = sumColumn(1);
                                            var TotalArtesania = sumColumn(2);
                                            var TotalArtesaniaPrem = sumColumn(3);
                                            var TotalTextil = sumColumn(4);
                                            var TotalFarmacia = sumColumn(5);
                                            var TotalAbarrotes = sumColumn(6);
                                            var TotalRefrescos = sumColumn(7);
                                            var TotalAguas = sumColumn(8);
                                            var TotalTabaqueria = sumColumn(9);
                                            var TotalCalendarios = sumColumn(10);
                                            var TotalEnergeticos = sumColumn(11);
                                            var TotalSinCategoria = sumColumn(12);
                                            var TotalGeneral = sumColumn(13);

                                            // Sumar tickets por día
                                            var TotalTickets = api.column(14, { page: 'current' }).data().reduce(function (a, b) {
                                                var value = typeof b === 'string' ? parseInt(b.replace(/[^0-9]/g, '')) || 0 : (parseInt(b) || 0);
                                                return a + value;
                                            }, 0);


                                            $('#sumaSouvenir').html('Total Souvenir: ' + formatCurrency(TotalSouvenir));
                                            $('#sumaArtesania').html('Total Artesanias: ' + formatCurrency(TotalArtesania));
                                            $('#sumaArtesaniaPrem').html('Total Art. Prem: ' + formatCurrency(TotalArtesaniaPrem));
                                            $('#sumaTextil').html('Total Textil: ' + formatCurrency(TotalTextil));
                                            $('#sumaFarmacia').html('Total Farmacia: ' + formatCurrency(TotalFarmacia));
                                            $('#sumaAbarrotes').html('Total Abarrotes: ' + formatCurrency(TotalAbarrotes));
                                            $('#sumaRefrescos').html('Total Refrescos: ' + formatCurrency(TotalRefrescos));
                                            $('#sumaAguas').html('Total Aguas: ' + formatCurrency(TotalAguas));
                                            $('#sumaTabaqueria').html('Total Tabaqueria: ' + formatCurrency(TotalTabaqueria));
                                            $('#sumaCalendarios').html('Total Calendarios: ' + formatCurrency(TotalCalendarios));
                                            $('#sumaEnergeticos').html('Total Energeticos: ' + formatCurrency(TotalEnergeticos));
                                            $('#sumaSinCategoria').html('Total S/Cat: ' + formatCurrency(TotalSinCategoria));
                                            $('#sumaTotal').html('Total General: ' + formatCurrency(TotalGeneral));
                                            $('#sumaTicketCobrado').html('Total Ticket Cobrado: ' + TotalTickets);
                                            $('#sumaTicketPromedio').html('Ticket Promedio: ' + formatNumber(TotalGeneral / (TotalTickets > 0 ? TotalTickets : 1)));
                                        },
                                    });

                                    // Manejar el envío del formulario de filtrado
                                    $filtrarBusqueda.on('submit', function (event) {
                                        event.preventDefault();

                                        var fechaInicio = $('#fechaInicio').val();
                                        var fechaFin = $('#fechaFin').val();
                                        var almacen = $('#almacen').val();

                                        if (!fechaInicio || !fechaFin || !almacen) {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Ups...',
                                                text: 'Por favor, complete todos los campos antes de realizar la búsqueda.',
                                            });
                                            return;
                                        }

                                        var formData = {
                                            fechaInicio: fechaInicio,
                                            fechaFin: fechaFin,
                                            almacen: almacen,
                                        };

                                        $.ajax({
                                            url: '/AdminPages/filtrarTablaA',
                                            type: 'POST',
                                            data: formData,
                                            success: function (response) {
                                                if (!response.data || response.data.length === 0) {
                                                    Swal.fire({
                                                        icon: 'error',
                                                        title: 'No se han registrado datos para este filtro',
                                                        text: 'Seleccione los campos donde si haya datos y vuelva a intentar',
                                                    });
                                                    $tablaVAlmacen.DataTable().clear().draw();
                                                } else {
                                                    // Guardamos el total de registros de la BD en la variable global
                                                    totalRegistrosBD = response.totalRegistrosBD || 0;

                                                    var table = $tablaVAlmacen.DataTable();
                                                    table.clear().rows.add(response.data).draw();

                                                    // Mostrar sólo el tramo 1–N
                                                    $('.dataTables_info').html(
                                                        'Mostrando registros del 1 al ' + response.data.length
                                                    );
                                                }
                                            },
                                            error: function (jqXHR, textStatus, errorThrown) {
                                                console.error('Error al filtrar:', textStatus, errorThrown);
                                                Swal.fire({
                                                    icon: 'error',
                                                    title: 'Error',
                                                    text: 'Ocurrió un error al realizar la búsqueda. Por favor intente nuevamente.'
                                                });
                                            }
                                        });

                                    });
                                });
                            </script>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
    <script src="~/Scripts/ScriptsAdmins/ScriptVentasAdminTotal.js"></script>
</body>
</html>