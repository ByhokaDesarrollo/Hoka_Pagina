@model List<hoka.Models.AllModels>

@using PagedList.Mvc;

@{
    ViewBag.Title = "Lista de usuarios";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" integrity="sha384-gfdkjb5BdAXd+lj+gudLWI+BXq4IuLW5IT+brZEZsLFm++aCMlF1V92rMkPaX4PP" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <link href="~/Content/css/StylesParaTablas.css" rel="stylesheet" />
    <link href="~/Content/css/LusuariosAdminCSS.css" rel="stylesheet" />

    <style>
        



    </style>

</head>
<body>

    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="@Url.Action("InicioAdminTotal", "AdminPages")" class="nav-link">Inicio</a>
                </li>

            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!--AQUI VA PARA AUMENTAR LA PANTALLA-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("CerrarSesion","Acceso")" class="nav-link">Salir</a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        @*CONTENIDO*@
        <div class="content-header">
            @*CONTENIDO*@
            <section class="content-header">
                @*TITULO DEL AREA*@
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>LISTA USUARIOS</h1>

                        </div>
                    </div>
                </div><!-- /.container-fluid -->
                <hr />
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <a class="btn btn-orange" id="abrirModalBoton">
                            <i class="fas fa-user-plus"></i> Registrar Usuario
                        </a>
                        <div class="card-tools">
                            <form method="get" action="@Url.Action("LUsuariosAdminTotal", "AdminPages")">
                                <div class="input-group input-group-sm responsive-search">
                                    <input type="text" name="buscar" class="form-control float-right" placeholder="Buscar" value="@Request.QueryString["buscar"]">
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-default">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="card-body table-responsive p-0" style="height: 400px;">
                            <table class="table table-head-fixed text-nowrap tabla-ajustada">
                                <thead>
                                    <tr>
                                        <th class="ancho-50">Id</th>
                                        <th class="ancho-100">Nombres</th>
                                        <th class="ancho-100">Apellido</th>
                                        <th class="ancho-120">Fecha Nacimiento</th>
                                        <th class="ancho-120">Telefono</th>
                                        <th class="ancho-150">Correo</th>
                                        <th class="ancho-100">Clave</th>
                                        <th class="ancho-80">Rol</th>
                                        <th class="ancho-120">Perfil</th>
                                        <th class="ancho-100">Estado</th>
                                        <th class="ancho-120">Fecha registro</th>
                                        <th class="ancho-350">Configuración</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            foreach (var usuario in item.UsuariosM)
                                            {
                                                <tr>
                                                    <td>@usuario.Id_Usuario</td>
                                                    <td>@usuario.NombreU</td>
                                                    <td>@usuario.ApellidoU</td>
                                                    <td>@usuario.FechaNacimientoU</td>
                                                    <td>@usuario.Telefono</td>
                                                    <td>@usuario.Correo</td>
                                                    <td>@usuario.Clave</td>
                                                    <td>@GetRolNombre(usuario.Id_Rol)</td>
                                                    <td>@GetPerfilNombre(usuario.Id_Perfil)</td>
                                                    @*<td>@GetCiudadNombre(usuario.Id_Ciudad)</td>
                                        <td>@GetTiendaNombre(usuario.Id_Tienda)</td>*@
                                                    <td>@GetEstadoNombre(usuario.Id_Estado)</td>
                                                    <td>@usuario.FechaRegistroU</td>
                                                    <td>
                                                        <!--Informacion del usuario-->
                                                        <a class="btn btn-primary btn-sm" href="@Url.Action("EditarUsuario","AdminPages", new { idUsuario = usuario.Id_Usuario})">
                                                            <i class="fas fa-user-edit"></i>Usuario</a>
                                                        <!--Editar contraseña-->
                                                        <!--<a class="btn btn-info btn-sm" href="@Url.Action("EditarContraseña","AdminPages", new { idUsuario = usuario.Id_Usuario})">
                                                            <i class="fas fa-unlock-alt"></i>Clave</a>-->
                                                        <!--Editar permisos-->
                                                        <a class="btn btn-secondary btn-sm" href="@Url.Action("EditarPermisos","AdminPages", new { idUsuario = usuario.Id_Usuario})">
                                                            <i class="fas fa-tasks"></i>Permisos</a>
                                                        <!--eliminar-->
                                                        <a onclick="AlertaBorrarUsuario('@usuario.Id_Usuario')" class="btn btn-danger btn-sm">
                                                            <i class="fas fa-trash"></i>Eliminar</a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14">No se encontraron resultados.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!--Modal para registro-->
                        <div class="modal" id="ModalRegistro">
                            <div class="modal-container">
                                <div class="modal-content">
                                    <span class="close">&times;</span>
                                    <p class="login-box-msg">Registro de usuario</p>

                                    <div class="card-body register-card-body">

                                        <!--Aqui vamos a inciar con el formulario para el registro-->
                                        <form id="form-registro" action="@Url.Action("RegistrarUsuario", "AdminPages")" method="post">

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p class="login-box-msg">Datos Personales</p>
                                                    <!-- DATOS PERSONALES DE LOS USUARIOS AL REGISTRARSE -->

                                                    <input type="hidden" class="form-control" id="Id_Usuario_edit" name="Id_Usuario" />

                                                    <div class="input-group mb-3">
                                                        <input type="text" class="form-control" name="NombreU" placeholder="Nombre: Ej. Juan">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <span class="fas fa-user"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="input-group mb-3">
                                                        <input type="text" class="form-control" name="ApellidoU" placeholder="Apellido: Ej. Lopez">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <span class="fas fa-user"></span>
                                                            </div>
                                                        </div>
                                                    </div>


                                                    <div class="input-group mb-3">
                                                        <input type="text" id="FechaNacimientoU" name="FechaNacimientoU" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <i class="far fa-calendar"></i>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="input-group mb-3">
                                                        <input type="number" class="form-control" name="Telefono" placeholder="000-000-0000" oninput="if(this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" maxlength="10">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <i class="fas fa-phone"></i>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <p class="login-box-msg">Datos de usuario</p>

                                                    <div class="input-group mb-3">
                                                        <input type="email" class="form-control" placeholder="Correo" name="Correo" autocomplete="off">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <span class="fas fa-envelope"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="input-group mb-3">
                                                        <input type="password" class="form-control" placeholder="Contraseña" name="Clave" autocomplete="new-password">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <span class="fas fa-lock"></span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="input-group mb-3">
                                                        <input type="password" class="form-control" placeholder="Confirmar Contraseña" name="ConfirmarClave">
                                                        <div class="input-group-append">
                                                            <div class="input-group-text">
                                                                <span class="fas fa-lock"></span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>

                                                <!-- HACER UNA DIVISION EN EL HTML O CSS PARA UNA MEJOR VISUALIZACION -->
                                                <!-- DATOS GENERALES DE LOS USUARIOS -->

                                                <div class="col-md-6">
                                                    <p class="login-box-msg">Configuración del usuario</p>

                                                    <div class="input-group mb-3">
                                                        <select class="form-control select2 rol-select" style="width: 100%" id="Id_Rol" name="Id_Rol" data-url="@Url.Action("AdminPages","ObtenerPerfiles")">
                                                            <option selected="selected">Selecciona un Rol</option>
                                                            @foreach (var rolmodel in Model)
                                                            {
                                                                foreach (var rol in rolmodel.RolesM)
                                                                {
                                                                    <option value="@rol.Id_Rol">@rol.Nombre_Rol</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="input-group mb-3">
                                                        <select class="form-control select2 perfil-select" style="width: 100%" id="Id_Perfil" name="Id_Perfil" disabled data-url="@Url.Action("AdminPages","ObtenerAlmacenes")">
                                                            <option selected="selected">Selecciona un Perfil</option>
                                                        </select>
                                                    </div>

                                                    <div class="input-group mb-3">
                                                        <select class="form-control select2 almacen-select" style="width: 100%" id="Almacenes" name="Almacenes[]" disabled multiple>
                                                            <option selected="selected">Selecciona un Almacen</option>
                                                        </select>
                                                        <input type="checkbox" class="form-check checkboxAlmacen-select" name="allalmacen" value="allalmacen" disabled> Selecciona todos los almacenes
                                                    </div>


                                                    <div class="input-group mb-3">
                                                        <select class="form-control select2 permiso-select" style="width: 100%" id="Permisos[]" name="Permisos[]" multiple>
                                                            <option selected="selected">Selecciona un Permiso</option>
                                                            @foreach (var permisomodel in Model)
                                                            {
                                                                foreach (var permiso in permisomodel.PermisosM)
                                                                {
                                                                    <option value="@permiso.Id_Permiso">@permiso.Nombre_Permiso</option>
                                                                }
                                                            }
                                                        </select>
                                                        <input type="checkbox" class="form-check checkboxPermiso-select" name="allpermiso" value="allpermiso"> Selecciona todos los permisos
                                                    </div>


                                                    <div class="input-group mb-3">
                                                        <select class="form-control select2 estado-select" style="width: 100%" id="Id_Estado" name="Id_Estado">
                                                            <option selected="selected">Selecciona un Estado</option>
                                                            @foreach (var estadomodel in Model)
                                                            {
                                                                foreach (var estado in estadomodel.EstadoUM)
                                                                {
                                                                    <option value="@estado.Id_Estado">@estado.Nombre_Estado</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row button-container">
                                                <div class="col-md-6">
                                                    <button id="btn-cerrarmodal" type="submit" class="btn btn-warning btn-block"><i class="fas fa-user-times"></i>Volver</button>
                                                </div>
                                                <div class="col-md-6">
                                                    <button id="btn-registro" type="submit" class="btn btn-success btn-block"><i class="fas fa-user-check"></i>Registrar usuario</button>
                                                </div>
                                            </div>


                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--FINAL Modal para REGISTRO USUARIO-->
                        <style>
                            .pagination {
                                justify-content: flex-end;
                            }
                        </style>

                        <div class="pagination">
                            <ul class="pagination">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("LUsuariosAdminTotal", new { buscar = ViewBag.Buscar, page = ViewBag.CurrentPage - 1 })">&laquo;</a>
                                </li>

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("LUsuariosAdminTotal", new { buscar = ViewBag.Buscar, page = i })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("LUsuariosAdminTotal", new { buscar = ViewBag.Buscar, page = ViewBag.CurrentPage + 1 })">&raquo;</a>
                                </li>
                            </ul>
                        </div>
                        <!--SCRIPT-->

                    </div>
                </div>
                <!-- /.card -->
            </section>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha2/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="~/Scripts/AlertaEliminarAdmins.js"></script>
    <script src="~/Scripts/ScriptsAdmins/ScriptAdminTotal.js"></script>



    @functions {
        // Función para obtener el nombre de un Rol por su ID
        public string GetRolNombre(int idRol)
        {
            var rol = Model.FirstOrDefault().RolesM.FirstOrDefault(r => r.Id_Rol == idRol);
            return rol != null ? rol.Nombre_Rol : "";
        }

        // Función para obtener el nombre de un Perfil por su ID
        public string GetPerfilNombre(int? idPerfil)
        {
            var perfil = Model.FirstOrDefault().PerfilM.FirstOrDefault(p => p.Id_Perfil == idPerfil);
            return perfil != null ? perfil.Nombre_Perfil : "Sin Perfil";
        }

        // Función para obtener el nombre de un Estado por su ID
        public string GetEstadoNombre(int idEstado)
        {
            var estado = Model.FirstOrDefault().EstadoUM.FirstOrDefault(e => e.Id_Estado == idEstado);
            return estado != null ? estado.Nombre_Estado : "";
        }
    }


</body>
</html>