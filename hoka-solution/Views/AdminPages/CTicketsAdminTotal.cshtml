
@{
    ViewBag.Title = "CONSULTA POR TICKET";
    Layout = "~/Views/Shared/_LayoutAdminTotal.cshtml";
}


<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="~/Content/css/selectcomprim.css" rel="stylesheet" />
    <link href="~/Content/css/estilosfiltroscss.css" rel="stylesheet" />
    <link href="~/Content/css/botonExcel.css" rel="stylesheet" />

    <!--para llamar el script tengo que cargarlo asi-->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="~/Scripts/ScriptsAdmins/ScriptConsultaTicketsAdminTotal.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.0.1/css/buttons.dataTables.min.css">
    <script src="https://cdn.datatables.net/buttons/2.0.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.7.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.0.1/js/buttons.html5.min.js"></script>



</head>
<body>
    <div class="wrapper">
        <!--Inicio de sidebar-->
        <nav class="main-sidebar-custom-lg navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" href="@Url.Action("InicioAdminTotal","AdminPages")">Inicio</a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <!--aqui el icon de aumentar pantalla-->
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("CerrarSesion","Acceso")">Salir</a>
                </li>
            </ul>
        </nav>


        <!--Inicio de paginacion-->
        <div class="content-header">
            <section class="content-header">
                <!--Inicio de titulo-->
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>CONSULTA POR TICKET</h1>
                        </div>
                    </div>
                </div>
                <hr />


                <!--Inicio de contenido-->
                <div class="card">
                    <!--Inicio de Botones del sidebar de la tabla de contenido-->
                    <div class="card-header">
                        @using (Html.BeginForm("AdminPages", "filtrarTablaCT", FormMethod.Post, new { id = "filtrarBusqueda" }))
                        {

                            <div class="row">
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaInicioR">Fecha inicio:</label>
                                    <input type="text" id="fechaInicio" name="fechaInicio" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>
                                <div class="col-lg-2 col-md-4 col-sm-6 col-12">
                                    <label for="fechaFinR">Fecha fin:</label>
                                    <input type="text" id="fechaFin" name="fechaFin" class="form-control" placeholder="dd/mm/aaaa" autocomplete="off">
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <label for="almacen">Almacén</label>
                                    <select class="form-control select2 almacen-select" style="width: 100%" id="almacen" name="almacen">
                                        <option selected="selected">Selecciona un almacén</option>
                                        @foreach (var almacen in ViewBag.Almacenes)
                                        {
                                            <option value="@almacen.Item2">@($"{almacen.Item1} - {almacen.Item2}")</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-4 col-sm-6 col-12 mt-2 mt-lg-0">
                                    <label for="btn-filtrar">Filtrar:</label>
                                    <div>
                                        <button type="submit" id="btn-filtrar" class="btn btn-info">
                                            <i class="fas fa-search"></i> Buscar
                                        </button>
                                    </div>
                                </div>

                            </div>
                        }


                    </div>


                    <!--Cuerpo del contenido(en este caso la tabla)-->
                    <div class="card-body">
                        <div class="table table-responsive">
                            <table class="table table-striped" id="tablaRemisiod">
                                <thead>
                                    <tr>
                                        <th>Folio</th> <!--esta en remisioD-->
                                        <th>Almacen</th>
                                        <th>Tipo de Cambio</th> <!--remisioD-->
                                        <th>Total Venta</th> <!--categoria esta en remisioD-->
                                        <th>Fecha</th><!--esta en remisioD-->
                                        <th>Detalle del ticket</th><!--esta en remisioD-->
                                    </tr>
                                </thead>
                                <tbody>
                                    <!--Aqui ira el contenido de la peticion
                                    por filtrado de busqueda
                                    -->
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th id="sumaVentaTotal">Total Venta:</th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>


                        <!--Scriptt-->

                    </div>

                    <!--Aqui termina el cuerpo-->
                </div>
            </section>
        </div>
    </div>
</body>
</html>

