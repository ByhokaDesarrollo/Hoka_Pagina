                                    $filtrarBusqueda.on('submit', function (event) {
                                        event.preventDefault();

                                        var fechaInicio = $('#fechaInicio').val();
                                        var fechaFin = $('#fechaFin').val();
                                        var almacen = $('#almacen').val();
                                        var categoria = $('#categoria').val();
                                        var grupo = $('#grupo').val();


                                        // Validar campos
                                        if (!fechaInicio || !fechaFin ||  !almacen || !categoria.length || !grupo.length) {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Ups...',
                                                text: 'Por favor, complete todos los campos antes de realizar la búsqueda.',
                                            });
                                            return;
                                        }

                                        var formData = {
                                            fechaInicio: fechaInicio,
                                            fechaFin: fechaFin,
                                            almacen: almacen,
                                            categoria: categoria,
                                            grupo: grupo
                                        };

                                        var PaginaActual = $tablaRemisiod.DataTable().page();
                                        var PaginaCantidad = $('#PaginaCantidad').val();
                                        formData.page = PaginaActual;
                                        formData.PaginaCantidad = PaginaCantidad;

                                        $.ajax({
                                            //url: '/AdminPages/filtrarTablaR',
                                            url: '/AdminPages/getReportSalesByProduct',
                                            type: 'POST',
                                            data: formData,
                                            success: function (data) {
                                                // Comprobar si los datos están vacíos
                                                if (!data || data.length === 0) {
                                                    Swal.fire({
                                                        icon: 'error',
                                                        title: 'No se han registrado datos para este filtro',
                                                        text: 'Seleccione los campos donde si haya datos y vuelva a intentar',
                                                    });
                                                } else {
                                                    // Actualizar los datos de la tabla con la respuesta del servidor
                                                    $tablaRemisiod.DataTable().clear().rows.add(data).draw();

                                                }
                                            },
                                            error: function (jqXHR, textStatus, errorThrown) {
                                                alert('Error al filtrar/verificar filtrobusqueda');
                                            }
                                        });
                                    });

                                    $tablaRemisiod.on('length.dt', function (e, settings, len) {

                                    });

                                });

                            </script>
