                        <img src="~/Content/img/users/IconoUser.jpg" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info-container1">
                        @{
                            // Obtener los valores de la sesión
                            string NombreUser = Session["NombreUser"] as string ?? "No identificado";
                            string NombreRol = Session["NombreRol"] as string ?? "Sin especificar";
                            string NombrePerfil = Session["NombrePerfil"] as string ?? "Sin especificar";
                        }

                        <div class="info1">
                            <a id="textotitulo" class="text-light font-weight-bold">Hola, @NombreUser!</a>
                        </div>

                        <div class="info1">
                            <span class="text-light font-weight-normal">Rol: @NombreRol</span>
                        </div>

                        <div class="info1">
                            <span class="text-light font-weight-normal">Perfil: @NombrePerfil</span>
                        </div>
                    </div>

                </div>

                <style>
                    .info-container1 {
                        flex: 1;
                        display: flex;
                        flex-direction: column;
                        margin-left: 11px; /* Ajusta este valor según tus necesidades */
                    }


                    .info1 span {
                        display: block;
                    }
                </style>


