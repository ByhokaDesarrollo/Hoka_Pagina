    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>*@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>

    <!--PARA EL DESPLIEGUE DE OPCIONES-->
    <script>
        $(document).ready(function () {

            function closeSameLevelDropdowns(currentToggle) {
                // Obtener el contenedor padre del botón de despliegue presionado
                var parentContainer = $(currentToggle).closest('.nav-item');

                // Cerrar todos los menús de despliegue que son hijos directos del contenedor padre, excepto el actual
                $(parentContainer).siblings().find('> .nav-treeview1:visible').slideUp();
                $(parentContainer).siblings().find('> .toggle-menu .fas.right.fa-angle-down').removeClass('fa-angle-down').addClass('fa-angle-left');
            }

            $(".toggle-menu").off('click').on('click', function (event) {
                event.preventDefault();

                // Encuentra el menú desplegable del botón actual
                var currentDropdown = $(this).closest('.nav-item').find('> .nav.nav-treeview1');

                // Si el menú actual está abierto, solo lo cierras. Si no, cierras los menús del mismo nivel y abres este.
                if (currentDropdown.is(':visible')) {
                    currentDropdown.slideUp();
                    $(this).find('.fas.right').removeClass('fa-angle-down').addClass('fa-angle-left');
                } else {
                    closeSameLevelDropdowns(this);
                    currentDropdown.slideDown();
                    $(this).find('.fas.right').removeClass('fa-angle-left').addClass('fa-angle-down');
                }
            });

            // Si hay un item activo dentro de un menú desplegable, mantén ese menú abierto
            if ($('.nav-item.active').parents('.nav-treeview1').length > 0) {
                $('.nav-item.active').parents('.nav-treeview1').show();
                $('.nav-item.active').parents('.nav-item').find('.toggle-menu .fas.right').removeClass('fa-angle-left').addClass('fa-angle-down');
            }

        });


    </script>


