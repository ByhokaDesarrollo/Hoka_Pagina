@using hoka.HokaCli.Models.Compuadmo.Voucher;
@using hoka.HokaCli.Models.Compuadmo.Usuario.Permiso.AlmacenCaratula;
@using hoka.HokaCli.Models.Ingresos.AlmacenCaratula;
@using hoka.HokaCli.Models.Ingresos.AlmacenCaratulaVoucher;
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    string tituloFondoColor = "#9c8050";
    string tituloTexto = "CARÁTULA VOUCHER (ACTUALIZAR)";
    string tituloTextoColor = "#fff";
    string tablaEncabezadoFondoColor = "#f3f3f3";
    string buttonFooterAncho = "width:220px;";
    EnAlmacenCaratula Caratula = ViewBag.Caratula;
    EnUsuarioPermisoAlmacenCaratula PermisoCaratula = ViewBag.PermisoCaratula;
    EnAlmacenCaratulaVoucher CaratulaVoucher = ViewBag.AlmacenCaratulaVoucher;
    decimal importeMxnTotal = Math.Round(CaratulaVoucher.ImporteTotal, 2);
    ICollection<EnVoucher> Vouchers = ViewBag.Vouchers;
    string idModalCrearVoucher = "modalCrearVoucher";
    string idModalCrearVoucherTextoError = "modalCrearVoucherTextoError";
    string idModalCrearVoucherButtonAbrir = "modalCrearVoucherButtonAbrir";
    string idModalCrearVoucherButtonCerrar = "modalCrearVoucherButtonCerrar";
    string idModalCrearVoucherSelectVoucher = "modalCrearVoucherSelectVoucher";
    string idModalCrearVoucherInputVoucherImporte = "modalCrearVoucherInputVoucherImporte";
    string idTableVoucher = "tableVoucher";
    string classVoucherConsecutivo = "voucher-consecutivo";
    string classVoucherImporte = "voucher-importe";
    string classVoucherImporteMxn = "voucher-importemxn";
    string classVoucherEliminar = "voucher-eliminar";
    string classRegistro = "registro";
    string classRegistroVoucher = "registro-voucher";
    string classImporteTotal = "importe-total";
    string classImporteTotalMxn = "importemxn-total";
    string idInputImporteTotalMxn = "inputImporteTotalMxn";
}

<style>
</style>

<div class="container-fluid">
    @*Título*@
    <div class="row mb-2">
        <div class="col text-center"
             style="background-color: @(tituloFondoColor); color: @(tituloTextoColor)">
            <strong>
                @tituloTexto
            </strong>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="card ml-2 mr-2 p-2">
        @*Acciones*@
        <div class="row mb-1">
            <div class="col">

                @*FILA PARA BOTONES*@

                @*<a role="button" class="btn btn-success btn-sm">
                        <i class="bi bi-clipboard-plus-fill"></i>
                        Nuevo Registro
                    </a>*@
            </div>
        </div>
        @*Capturar Vouchers*@
        <div class="row mb-1">
            <div class="col">
                <button type="button"
                        class="btn btn-sm btn-success"
                        id="@idModalCrearVoucherButtonAbrir"
                        onclick="abrirModalCrearVoucher()">
                    <i class="bi bi-floppy-fill"></i>
                    Capturar Vouchers
                </button>
            </div>
        </div>
        @*Modal*@
        <div class="modal fade show"
             id="@idModalCrearVoucher"
             style="display: block;"
             aria-modal="true"
             role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="col text-center">
                            <strong>
                                Agregar Nuevo Registro
                            </strong>
                        </div>
                    </div>
                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row g-1 align-items-center">
                                <div class="col-3">
                                    <label for="@idModalCrearVoucherSelectVoucher"
                                           class="col-form-label">
                                        Voucher
                                    </label>
                                </div>
                                <div class="col-9">
                                    <select class="form-select form-select-sm"
                                            id="@idModalCrearVoucherSelectVoucher">
                                        <option value="0"
                                                data-tipo-cambio="0"
                                                selected>
                                            Seleccionar Voucher...
                                        </option>
                                        @foreach (var voucher in Vouchers)
                                        {
                                            <option value="@voucher.VoucherId"
                                                    data-tipo-cambio="@voucher.Moneda.Valor">
                                                @voucher.Nombre
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row g-1 align-items-center">
                                <div class="col-3">
                                    <label for="@idModalCrearVoucherInputVoucherImporte"
                                           class="col-form-label">
                                        Importe
                                    </label>
                                </div>
                                <div class="col-9">
                                    <input type="number"
                                           class="form-control form-control-sm text-right"
                                           id="@idModalCrearVoucherInputVoucherImporte"
                                           onkeypress="agregarVoucher(event)">
                                </div>
                            </div>
                            <div class="row g-1 align-items-center">
                                <div class="col-3"></div>
                                <div class="col-9">
                                    <div class="form-text">
                                        <strong class="text-success">
                                            Presione la tecla "Enter" para capturar el Voucher
                                        </strong>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-1 align-items-center">
                                <div class="col-3"></div>
                                <div class="col-9">
                                    <div class="form-text">
                                        <strong class="text-danger"
                                                id="@idModalCrearVoucherTextoError">
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                id="@idModalCrearVoucherButtonCerrar"
                                onclick="cerrarModalCrearVoucher()">
                            <i class="bi bi-x-lg"></i>
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mb-1">
            <div class="col text-center">
                @*Tabla Voucher Recibo*@
                <table class="table table-responsive table-sm table table-bordered"
                       id="@idTableVoucher">
                    <thead>
                        <tr>
                            <th colspan="6"
                                style="background-color: @(tablaEncabezadoFondoColor);">
                                Voucher
                            </th>
                        </tr>
                        <tr>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="260">
                                Voucher
                            </th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="180">
                                Tipo Cambio
                            </th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="180">
                                Consecutivo
                            </th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="180">
                                Importe
                            </th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="180">
                                Importe Mxn
                            </th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);"
                                width="120">
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var voucher in CaratulaVoucher.Vouchers.OrderBy(x => x.VoucherId))
                        {
                            string claseRegistroVoucher = classRegistroVoucher + voucher.VoucherId;
                            string claseVoucherConsecutivo = classVoucherConsecutivo + voucher.VoucherId;
                            string claseVoucherImporte = classVoucherImporte + voucher.VoucherId;
                            string claseVoucherImporteMxn = classVoucherImporteMxn + voucher.VoucherId;
                            string claseVoucherEliminar = classVoucherEliminar + voucher.VoucherId;
                            foreach (var recibo in voucher.Recibos.OrderBy(x => x.Consecutivo))
                            {
                                string idVoucherConsecutivo = claseVoucherConsecutivo + recibo.Consecutivo;
                                string idVoucherImporte = claseVoucherImporte + recibo.Consecutivo;
                                string idVoucherImporteMxn = claseVoucherImporteMxn + recibo.Consecutivo;
                                string idVoucherEliminar = claseVoucherEliminar + recibo.Consecutivo;
                                decimal importe = Math.Round(recibo.Importe, 2);
                                decimal importeMxn = Math.Round(recibo.ImporteMXN, 2);
                                <tr class="@classRegistro @claseRegistroVoucher"
                                    data-recibo-id="@recibo.AlmacenCaratulaVoucherReciboId"
                                    data-voucher-id="@recibo.AlmacenCaratulaVoucherVoucherId">
                                    <td>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               value="@voucher.Voucher.Nombre"
                                               disabled />
                                    </td>
                                    <td>
                                        <input type="number"
                                               class="form-control form-control-sm text-right"
                                               value="@voucher.Voucher.Moneda.Valor"
                                               disabled />
                                    </td>
                                    @*Tipo de Cambio*@
                                    <td>
                                        <input type="number"
                                               class="form-control form-control-sm text-center @claseVoucherConsecutivo"
                                               id="@idVoucherConsecutivo"
                                               value="@recibo.Consecutivo"
                                               data-consecutivo="@recibo.Consecutivo"
                                               data-class="@claseVoucherConsecutivo"
                                               data-class-voucher-importe="@claseVoucherImporte"
                                               data-class-voucher-importe-mxn="@claseVoucherImporteMxn"
                                               data-id-voucher-importe="@idVoucherImporte"
                                               data-id-voucher-importe-mxn="@idVoucherImporteMxn"
                                               disabled />
                                    </td>
                                    @*Importe*@
                                    <td>
                                        <input type="number"
                                               class="form-control form-control-sm text-right Importe @claseVoucherImporte"
                                               id="@idVoucherImporte"
                                               value="@importe"
                                               data-class="@claseVoucherImporte"
                                               data-tipo-cambio="@voucher.Voucher.Moneda.Valor"
                                               onchange="actualizarImporteRecibo('@(idVoucherImporte)', '@(idVoucherImporteMxn)')" />
                                    </td>
                                    @*Importe Mxn*@
                                    <td>
                                        <input type="number"
                                               class="form-control form-control-sm text-right @claseVoucherImporteMxn"
                                               id="@idVoucherImporteMxn"
                                               value="@importeMxn"
                                               data-class="@claseVoucherImporteMxn"
                                               disabled />
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-danger @claseVoucherEliminar"
                                                id="@idVoucherEliminar"
                                                data-class="@claseVoucherEliminar"
                                                data-id-voucher-consecutivo="@idVoucherConsecutivo"
                                                data-class-voucher-consecutivo="@claseVoucherConsecutivo"
                                                data-class-voucher-importe="@claseVoucherImporte"
                                                data-class-voucher-importemxn="@claseVoucherImporteMxn"
                                                onclick="eliminarRecibo(this)">
                                            <i class="bi bi-trash3-fill"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="6">Cuadre Voucher</th>
                        </tr>
                        <tr>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Voucher</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Importe Origen</th>
                            <th style="background-color: @(tablaEncabezadoFondoColor);">Importe Mxn</th>
                            <th colspan="3" scope="row" style="background-color: @(tablaEncabezadoFondoColor);"></th>
                        </tr>
                        @foreach (var voucher in CaratulaVoucher.Vouchers)
                        {
                            string idVoucherImporte = classImporteTotal + voucher.VoucherId;
                            string idVoucherImporteMxn = classImporteTotalMxn + voucher.VoucherId;
                            decimal importe = Math.Round(voucher.ImporteTotal, 2);
                            decimal importeMxn = Math.Round(voucher.ImporteTotalMXN, 2);
                            <tr>
                                <th scope="row"
                                    class="text-left">
                                    <input type="text"
                                           class="input form-control form-control-sm"
                                           name="name"
                                           value="@voucher.Voucher.Nombre"
                                           disabled />
                                </th>
                                <td>
                                    <input type="number"
                                           class="@classImporteTotal text-right"
                                           id="@idVoucherImporte"
                                           name="campo_importe"
                                           value="@importe"
                                           data-voucher-id="@voucher.VoucherId"
                                           data-voucher-class-importe="@classVoucherImporte"
                                           disabled />
                                </td>
                                <td>
                                    <input type="number"
                                           class="@(classImporteTotalMxn) text-right"
                                           id="@idVoucherImporteMxn"
                                           name="campo_importe"
                                           value="@importeMxn"
                                           data-voucher-id="@voucher.VoucherId"
                                           data-voucher-class-importemxn="@classVoucherImporteMxn"
                                           disabled />
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        }
                        <tr>
                            <th scope="row" style="background-color: @(tablaEncabezadoFondoColor);">Total Vouchers</th>
                            <td style="background-color: @(tablaEncabezadoFondoColor);"></td>
                            <td style="background-color: @(tablaEncabezadoFondoColor);">
                                <input type="number"
                                       class="text-right"
                                       id="@idInputImporteTotalMxn"
                                       name="campo_importe_Mxn"
                                       value="@importeMxnTotal"
                                       data-voucher-class-importemxn="@classImporteTotalMxn"
                                       disabled />
                            </td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col text-center">
                <a class="btn btn-sm btn-secondary"
                   href="@ViewBag.UrlIndexAlmacenCaratula"
                   role="button"
                   style="@buttonFooterAncho">
                    <i class="bi bi-house-door-fill"></i>
                    Gestor Ventas
                </a>
                <button type="button"
                        class="btn btn-sm btn-success"
                        onclick="actualizarAlmacenCaratulaVoucher()"
                        style="@buttonFooterAncho">
                    <i class="bi bi-floppy-fill"></i>
                    Actualizar
                </button>
                @*<button type="button"
                        class="btn btn-sm btn-primary"
                        onclick="GrabarAlmacenCaratulaVoucher()">
                    <i class="bi bi-floppy-fill"></i>
                    Grabar
                </button>*@
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script type="text/javascript">
    const jsonObjetoCaratulaVoucher = '@(Html.Raw(JsonConvert.SerializeObject(CaratulaVoucher)))';
    const oCaratulaVoucher = JSON.parse(jsonObjetoCaratulaVoucher);
    const elementoModal = document.getElementById('@(idModalCrearVoucher)');
    const elementoModalSelectVoucher = document.getElementById('@(idModalCrearVoucherSelectVoucher)');
    const elementoModalInputVoucherImporte = document.getElementById('@(idModalCrearVoucherInputVoucherImporte)');
    const elementoModalTextoError = document.getElementById('@(idModalCrearVoucherTextoError)');
    const elementoTableVoucherRecibo = document.getElementById('@(idTableVoucher)');

    $('#select_Voucher').select2({
        theme: 'bootstrap-5'
    });

    function abrirModalCrearVoucher() {
        elementoModal.style.display = 'block';
    }

    cerrarModalCrearVoucher();
    function cerrarModalCrearVoucher() {
        elementoModal.style.display = 'none';
    }

    function agregarVoucher(evento) {
        if (evento.keyCode === 13) {
            evento.preventDefault();
            elementoModalTextoError.innerHTML = '';
            agregarVoucherTablaVoucher();
        }
    }

    function agregarVoucherTablaVoucher() {
        let opcionVoucher = elementoModalSelectVoucher.options[elementoModalSelectVoucher.selectedIndex];
        let voucherId = opcionVoucher.value;
        let b_ValidarVoucherId = validarVoucherId(voucherId);
        if (!b_ValidarVoucherId)
            return b_ValidarVoucherId;
        let voucherImporte = convertirInputDecimal(elementoModalInputVoucherImporte);
        let b_ValidarVoucherImporte = validarVoucherImporte(voucherImporte);
        if (!b_ValidarVoucherImporte)
            return b_ValidarVoucherImporte;
        let voucherTexto = opcionVoucher.text;
        let voucherTipoCambio = opcionVoucher.dataset.tipoCambio;
        crearVoucherTablaVoucher(
            voucherId = voucherId,
            voucherTexto = voucherTexto,
            voucherTipoCambio = voucherTipoCambio,
            voucherImporte = voucherImporte
        );
        elementoModalInputVoucherImporte.value = '';
        elementoModalInputVoucherImporte.focus();
    }

    function validarVoucherId(voucherId) {
        if (voucherId <= 0) {
            elementoModalTextoError.innerHTML = 'Debe seleccionar un Voucher valido';
            elementoModalSelectVoucher.focus();
            return false;
        }
        return true;
    }

    function validarVoucherImporte(voucherImporte) {
        if (elementoModalInputVoucherImporte.value.length <= 0) {
            elementoModalTextoError.innerHTML = 'Debe introducir un Importe valido';
            elementoModalInputVoucherImporte.focus();
            return false;
        }
        if (voucherImporte <= 0) {
            elementoModalTextoError.innerHTML = 'Debe introducir un Importe mayor a 0';
            elementoModalInputVoucherImporte.focus();
            return false;
        }
        return true;
    }

    function convertirInputDecimal(elementoInput) {
        return parseFloat(elementoInput.value).toFixed(2);
    }

    function convertirValorDecimal(valor) {
        return parseFloat(valor).toFixed(2);
    }

    function crearVoucherTablaVoucher(voucherId, voucherTexto, voucherTipoCambio, voucherImporte) {
        let tipoCambio = convertirValorDecimal(voucherTipoCambio);
        let importe = convertirValorDecimal(voucherImporte);
        let importeMxn = convertirValorDecimal(tipoCambio * importe);
        let tbody = elementoTableVoucherRecibo.getElementsByTagName('tbody')[0];
        let tr = document.createElement('tr');
        tr.classList.add('@(classRegistro)');
        tr.classList.add('@(classRegistroVoucher)' + voucherId);
        tr.dataset.reciboId = 0;
        tr.dataset.voucherId = 0;
        let classVoucherConsecutivo = '@(classVoucherConsecutivo)' + voucherId;
        let classVoucherImporte = '@(classVoucherImporte)' + voucherId;
        let classVoucherImporteMxn = '@(classVoucherImporteMxn)' + voucherId;
        let classVoucherEliminar = '@(classVoucherEliminar)' + voucherId;
        let valorConsecutivo = calcularConsecutivo(classVoucherConsecutivo);
        let idVoucherConsecutivo = classVoucherConsecutivo + valorConsecutivo;
        let idVoucherImporte = classVoucherImporte + valorConsecutivo;
        let idVoucherImporteMxn = classVoucherImporteMxn + valorConsecutivo;
        let idVoucherEliminar = classVoucherEliminar + valorConsecutivo;
        for (var i = 0; i <= 5; i++) {
            let td = document.createElement('td');
            let elementoInput;
            if (i <= 4) {
                elementoInput = document.createElement('input');
                elementoInput.classList.add('form-control');
                elementoInput.classList.add('form-control-sm');
            }
            if (i == 5)
                elementoInput = document.createElement('button');
            switch (i) {
                case 0: // VoucherTexto
                    elementoInput.type = 'text';
                    elementoInput.value = voucherTexto;
                    elementoInput.disabled = true;
                    break;
                case 1: // TipoCambio
                    elementoInput.type = 'number';
                    elementoInput.classList.add('text-right');
                    elementoInput.value = tipoCambio;
                    elementoInput.disabled = true;
                    break;
                case 2: // Consecutivo
                    elementoInput = establecerValoresInputConsecutivo(
                        elementoInput = elementoInput,
                        classVoucherConsecutivo = classVoucherConsecutivo,
                        idVoucherConsecutivo = idVoucherConsecutivo,
                        valorConsecutivo = valorConsecutivo,
                        classVoucherImporte = classVoucherImporte,
                        classVoucherImporteMxn = classVoucherImporteMxn,
                        idVoucherImporte = idVoucherImporte,
                        idVoucherImporteMxn = idVoucherImporteMxn
                    );
                    break;
                case 4: // ImporteMxn
                    elementoInput = establecerValoresInputImporteMxn(
                        elementoInput = elementoInput,
                        classVoucherImporteMxn = classVoucherImporteMxn,
                        idVoucherImporteMxn = idVoucherImporteMxn,
                        importeMxn = importeMxn
                    );
                    break;
                default:
                    break;
            }
            td.appendChild(elementoInput);
            if (i == 3)
                // Importe
                elementoInput.outerHTML =
                    '<input ' +
                        'type="number" ' +
                        'class="form-control form-control-sm Importe ' + classVoucherImporte + ' text-right" ' +
                        'id="' + idVoucherImporte + '" ' +
                        'value=' + importe + ' ' +
                        'data-tipo-cambio=' + tipoCambio + ' ' +
                        'data-class="' + classVoucherImporte + '" ' +
                        'onchange="actualizarImporteRecibo(' +
                            "'" + idVoucherImporte + "', " +
                            "'" + idVoucherImporteMxn + "'" +
                        ')"> ';
            if (i == 5)
                elementoInput.outerHTML =
                    '<button ' +
                        'type="button" ' +
                        'class="btn btn-sm btn-danger ' + classVoucherEliminar + '" ' +
                        'id="' + idVoucherEliminar + '" ' +
                        'data-class="' + classVoucherEliminar + '" ' +
                        'data-id-voucher-consecutivo="' + idVoucherConsecutivo + '" ' +
                        'data-class-voucher-consecutivo="' + classVoucherConsecutivo + '" ' +
                        'data-class-voucher-importe="' + classVoucherImporte + '" ' +
                        'data-class-voucher-importemxn="' + classVoucherImporteMxn + '" ' +
                        'onclick="eliminarRecibo(this)"> ' +
                        '<i class="bi bi-trash3-fill"></i>' +
                        'Eliminar' +
                    '</button>';
            tr.appendChild(td);
        }
        tbody.appendChild(tr);
        actualizarTotales();
    }

    function calcularConsecutivo(classVoucherConsecutivo) {
        let coleccionInputVoucherConsecutivo = document.getElementsByClassName(classVoucherConsecutivo);
        let consecutivo = coleccionInputVoucherConsecutivo.length + 1;
        return consecutivo;
    }

    function establecerValoresInputConsecutivo(
        elementoInput,
        classVoucherConsecutivo,
        idVoucherConsecutivo,
        valorConsecutivo,
        classVoucherImporte,
        classVoucherImporteMxn,
        idVoucherImporte,
        idVoucherImporteMxn
    ) {
        elementoInput.type = 'number';
        elementoInput.classList.add('text-center');
        elementoInput.classList.add(classVoucherConsecutivo);
        elementoInput.id = idVoucherConsecutivo;
        elementoInput.value = parseInt(valorConsecutivo);
        elementoInput.dataset.consecutivo = valorConsecutivo;
        elementoInput.dataset.class = classVoucherConsecutivo;
        elementoInput.dataset.classVoucherImporte = classVoucherImporte;
        elementoInput.dataset.classVoucherImporteMxn = classVoucherImporteMxn;
        elementoInput.dataset.idVoucherImporte = idVoucherImporte;
        elementoInput.dataset.idVoucherImporteMxn = idVoucherImporteMxn;
        elementoInput.disabled = true;
        return elementoInput;
    }

    function establecerValoresInputImporteMxn(
        elementoInput,
        classVoucherImporteMxn,
        idVoucherImporteMxn,
        importeMxn
    ) {
        elementoInput.type = 'number';
        elementoInput.classList.add('text-right');
        elementoInput.classList.add(classVoucherImporteMxn);
        elementoInput.id = idVoucherImporteMxn;
        elementoInput.value = importeMxn;
        elementoInput.dataset.class = classVoucherImporteMxn;
        elementoInput.disabled = true;
        return elementoInput;
    }

    function eliminarRecibo(
        buttonEliminar
    ) {
        let idVoucherConsecutivo = buttonEliminar.dataset.idVoucherConsecutivo;
        let classVoucherConsecutivo = buttonEliminar.dataset.classVoucherConsecutivo;
        let classVoucherImporte = buttonEliminar.dataset.classVoucherImporte;
        let classVoucherImporteMxn = buttonEliminar.dataset.classVoucherImportemxn;
        let classVoucherEliminar = buttonEliminar.dataset.class;
        let inputBorrar = document.getElementById(idVoucherConsecutivo);
        let contadorConsecutivo = parseInt(document.getElementsByClassName(classVoucherConsecutivo).length);
        let valorConsecutivo = parseInt(inputBorrar.value);
        if (valorConsecutivo !== contadorConsecutivo)
        {
            let valorConsecutivoSiguiente = valorConsecutivo + 1;
            for (var i = valorConsecutivoSiguiente; i <= contadorConsecutivo; i++) {
                let idVoucherConsecutivoSiguiente = classVoucherConsecutivo + i;
                let idVoucherImporteSiguiente = classVoucherImporte + i;
                let idVoucherImporteMxnSiguiente = classVoucherImporteMxn + i;
                let idVoucherEliminarSiguiente = classVoucherEliminar + i;
                let inputConsecutivoSiguiente = document.getElementById(idVoucherConsecutivoSiguiente);
                let inputImporteSiguiente = document.getElementById(idVoucherImporteSiguiente);
                let inputImporteMxnSiguiente = document.getElementById(idVoucherImporteMxnSiguiente);
                let buttonEliminarSiguiente = document.getElementById(idVoucherEliminarSiguiente);
                // inputConsecutivoSiguiente
                let nuevoConsecutivo = parseInt(i - 1);
                let nuevoConsecutivoId = classVoucherConsecutivo + nuevoConsecutivo;
                let nuevoImporteId = classVoucherImporte + nuevoConsecutivo;
                let nuevoImporteMxnId = classVoucherImporteMxn + nuevoConsecutivo;
                let nuevoEliminarId = classVoucherEliminar + nuevoConsecutivo;
                inputConsecutivoSiguiente.id = nuevoConsecutivoId;
                inputConsecutivoSiguiente.value = parseInt(nuevoConsecutivo);
                inputConsecutivoSiguiente.dataset.consecutivo = nuevoConsecutivo;
                inputConsecutivoSiguiente.dataset.idVoucherImporte = nuevoImporteId;
                inputConsecutivoSiguiente.dataset.idVoucherImporteMxn = nuevoImporteMxnId;
                // inputImporteSiguiente
                let importe = convertirInputDecimal(inputImporteSiguiente);
                let tipoCambio = convertirValorDecimal(inputImporteSiguiente.dataset.tipoCambio);
                inputImporteSiguiente.outerHTML =
                    '<input ' +
                        'type="number" ' +
                        'class="form-control form-control-sm Importe ' + classVoucherImporte + ' text-right" ' +
                        'id="' + nuevoImporteId + '" ' +
                        'value=' + importe + ' ' +
                        'data-tipo-cambio=' + tipoCambio + ' ' +
                        'data-class="' + classVoucherImporte + '" ' +
                        'onchange="actualizarImporteRecibo(' +
                            "'" + nuevoImporteId + "', " +
                            "'" + nuevoImporteMxnId + "'" +
                        ')"> ';
                //// inputImporteMxnSiguiente
                let importeMxn = convertirValorDecimal(importe * tipoCambio);
                inputImporteMxnSiguiente.id = nuevoImporteMxnId;
                inputImporteMxnSiguiente.value = convertirValorDecimal(importeMxn);
                // buttonEliminar
                buttonEliminarSiguiente.id = nuevoEliminarId;
                buttonEliminarSiguiente.dataset.idVoucherConsecutivo = nuevoConsecutivoId;
            }
        }
        let rowIndex = inputBorrar.parentNode.parentNode.rowIndex;
        let trRecibo = inputBorrar.parentNode.parentNode;
        if (trRecibo.dataset.reciboId > 0)
            for (var oVoucher of oCaratulaVoucher.Vouchers) {
                for (var oRecibo of oVoucher.Recibos) {
                    if (parseInt(oRecibo.AlmacenCaratulaVoucherReciboId) === parseInt(trRecibo.dataset.reciboId))
                        oRecibo.B_Eliminar = true;
                }
            }
        elementoTableVoucherRecibo.deleteRow(rowIndex);
        actualizarTotales();
    }

    function actualizarImporteRecibo(idVoucherImporte, idVoucherImporteMxn) {
        let inputImporte = document.getElementById(idVoucherImporte);
        let inputImporteMxn = document.getElementById(idVoucherImporteMxn);
        let tipoCambio = convertirValorDecimal(inputImporte.dataset.tipoCambio);
        let nuevoImporte = convertirInputDecimal(inputImporte);
        let nuevoImporteMxn = convertirValorDecimal(nuevoImporte * tipoCambio);
        inputImporte.value = nuevoImporte;
        inputImporteMxn.value = nuevoImporteMxn;
        actualizarTotales();
    };

    function actualizarTotales() {
        let coleccionInputVoucherImporte = document.getElementsByClassName('@(classImporteTotal)');
        let coleccionInputVoucherImporteMxn = document.getElementsByClassName('@(classImporteTotalMxn)');
        let inputVoucherImporteMxn = document.getElementById('@(idInputImporteTotalMxn)');
        for (var importe of coleccionInputVoucherImporte) {
            let classVoucherImporteId = '@(classVoucherImporte)' + importe.dataset.voucherId;
            let internalInputsVoucherImporte = document.getElementsByClassName(classVoucherImporteId);
            let valorImporte = 0;
            for (var internalImporte of internalInputsVoucherImporte) {
                valorImporte += parseFloat(internalImporte.value);
            }
            importe.value = parseFloat(valorImporte).toFixed(2);
        }
        let totales = 0;
        for (var importe of coleccionInputVoucherImporteMxn) {
            let classVoucherImporteMxnId = '@(classVoucherImporteMxn)' + importe.dataset.voucherId;
            let internalInputsVoucherImporteMxn = document.getElementsByClassName(classVoucherImporteMxnId);
            let valorImporte = 0;
            for (var internalImporte of internalInputsVoucherImporteMxn) {
                valorImporte += parseFloat(internalImporte.value);
            }
            importe.value = parseFloat(valorImporte).toFixed(2);
            totales += parseFloat(importe.value);
        }
        inputVoucherImporteMxn.value = parseFloat(totales).toFixed(2);
    }

    function actualizarAlmacenCaratulaVoucher() {
        let UrlAlmacenCaratulaVoucher =
            '@(Url.Action("ActualizarAlmacenCaratulaVoucher", "AlmacenCaratulaVoucher"))';
        let AlmacenCaratulaVoucher = ObtenerAlmacenCaratulaVoucher();
        let bodyData = JSON.stringify(AlmacenCaratulaVoucher);
        fetch(UrlAlmacenCaratulaVoucher, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: bodyData
        })
        .then((res) => res.text())
        .then((data) => {
            if (data != 'error') {
                window.location.replace(data);
            } else {
                console.log('error');
            }
        });
    }

    function ObtenerAlmacenCaratulaVoucher() {
        let inputVoucherImporteMxn = document.getElementById('@(idInputImporteTotalMxn)');
        let importeTotal = parseFloat(inputVoucherImporteMxn.value);
        let AlmacenCaratulaVoucher = {
            AlmacenCaratulaVoucherId: parseInt(@CaratulaVoucher.AlmacenCaratulaVoucherId),
            AlmacenCaratulaId: parseInt(@Caratula.AlmacenCaratulaId),
            UsuarioId: 1,
            FechaCaptura: null,
            ImporteTotal: parseFloat(importeTotal)
        };
        AlmacenCaratulaVoucher.Vouchers = ObtenerAlmacenCaratulaVoucherVouchers();
        return AlmacenCaratulaVoucher;
    }

    function ObtenerAlmacenCaratulaVoucherVouchers() {
        let listaVouchers = [];
        for (var oVoucher of oCaratulaVoucher.Vouchers) {
            let idVoucherImporte = '@(classImporteTotal)' + oVoucher.VoucherId;
            let idVoucherImporteMxn = '@(classImporteTotalMxn)' + oVoucher.VoucherId;
            let inputImporte = document.getElementById(idVoucherImporte);
            let inputImporteMxn = document.getElementById(idVoucherImporteMxn);
            let importeTotal = convertirInputDecimal(inputImporte);
            let importeTotalMxn = convertirInputDecimal(inputImporteMxn);
            let voucher = {
                AlmacenCaratulaVoucherVoucherId: oVoucher.AlmacenCaratulaVoucherVoucherId,
                AlmacenCaratulaVoucherId: oVoucher.AlmacenCaratulaVoucherId,
                VoucherId: oVoucher.VoucherId,
                TipoCambio: oVoucher.Voucher.Moneda.Valor,
                ImporteTotal: parseFloat(importeTotal),
                ImporteTotalMxn: parseFloat(importeTotalMxn)
            }
            voucher.Recibos = ObtenerAlmacenCaratulaVoucherRecibos(oVoucher.VoucherId);
            listaVouchers.push(voucher);
        }
        return listaVouchers;
    }

    function ObtenerAlmacenCaratulaVoucherRecibos(voucherId) {
        let listaRecibos = [];
        let classRegistroVoucher = '@(classRegistroVoucher)' + voucherId;
        let oRecibos = document.getElementsByClassName(classRegistroVoucher);
        for (var oRecibo of oRecibos) {
            let recibo = {
                AlmacenCaratulaVoucherReciboId: parseInt(oRecibo.dataset.reciboId),
                AlmacenCaratulaVoucherVoucherId: parseInt(oRecibo.dataset.voucherId),
                Consecutivo: parseInt(oRecibo.children[2].children[0].value),
                Importe: parseFloat(oRecibo.children[3].children[0].value),
                ImporteMxn: parseFloat(oRecibo.children[4].children[0].value)
            };
            listaRecibos.push(recibo);
        }
        for (var oVoucher of oCaratulaVoucher.Vouchers) {
            if (parseInt(oVoucher.VoucherId) === parseInt(voucherId))
                for (var oRecibo of oVoucher.Recibos) {
                    if (oRecibo.B_Eliminar == true)
                        listaRecibos.push(oRecibo);
                }
        }
        return listaRecibos;
    }

    function GrabarAlmacenCaratulaVoucher() {
        let UrlAlmacenCaratulaVoucher =
            '@(Url.Action("GrabarAlmacenCaratulaVoucher", "AlmacenCaratulaVoucher"))';
        let AlmacenCaratulaVoucher = ObtenerAlmacenCaratulaVoucher();
        let bodyData = JSON.stringify(AlmacenCaratulaVoucher);
        fetch(UrlAlmacenCaratulaVoucher, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: bodyData
        })
        .then((res) => res.text())
        .then((data) => {
            if (data != 'error') {
                window.location.replace(data);
            } else {
                console.log('error');
            }
        });
    }
    </script>
}
